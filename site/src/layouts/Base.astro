---
import "@fontsource-variable/sora";
// The display face sets every title; preloaded so titles render at their measured width on first paint.
import soraLatin from "@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@site/styles/shell.css";
import "@site/styles/platform-shell.css";
import SiteFooter from "@site/components/SiteFooter.astro";
import SiteHeader from "@site/components/SiteHeader.astro";
import { asset, href, ui, type Lang } from "@site/i18n";
import { shellTokensCss } from "@site/shell";

interface Props {
  lang: Lang;
  /** Path relative to the language root, used by the language switch, e.g. a case slug. */
  path: string;
  title?: string;
  description?: string;
  /** Structured data for this page, one object with an @graph. */
  jsonLd?: Record<string, unknown>;
}

const { lang, path, title, description, jsonLd } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} | Metix AI Platform ${t.casebook}` : `${t.casebook}: ${t.siteName}`;
const canonical = new URL(href(lang, path), Astro.site).href;
// Drawn by pages/og/ and screenshotted after the build (tools/og_shots.py).
const ogImage = new URL(href(lang, path ? `og/${path}.png` : "og.png"), Astro.site).href;
const ogAlt = title ? `${title}. ${description ?? ""}`.trim() : t.home.title;
const alternate = (l: Lang) => new URL(href(l, path), Astro.site).href;
---

<!doctype html>
<html lang={t.htmlLang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Before first paint, so the page never lays out in its no-JavaScript form. -->
    <script is:inline src={asset("js-class.js")}></script>
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t.siteDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={asset("favicon.png")} />
    <link rel="alternate" hreflang="en" href={alternate("en")} />
    <link rel="alternate" hreflang="zh" href={alternate("zh")} />
    <link rel="alternate" hreflang="x-default" href={alternate("en")} />
    <meta property="og:type" content={title ? "article" : "website"} />
    <meta property="og:site_name" content="Metix AI Platform" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title ?? `${t.casebook}: ${t.siteName}`} />
    <meta property="og:description" content={description ?? t.siteDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <style set:html={shellTokensCss()}></style>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <SiteHeader lang={lang} path={path} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter lang={lang} />

    <script is:inline src={asset("casebook.js")} defer></script>
  </body>
</html>
