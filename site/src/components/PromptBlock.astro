---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { ui, type Lang } from "@site/i18n";

interface Props {
  lang: Lang;
  Content: AstroComponentFactory;
}

const { lang, Content } = Astro.props;
const t = ui[lang];
---

<section class="block" id="prompt" aria-labelledby="prompt-title" data-copy-root>
  <div class="block-head">
    <h2 id="prompt-title">{t.promptTitle}</h2>
    <button class="btn" type="button" data-copy=".prompt-body pre" data-done={t.copied} data-fail={t.copyFailed} aria-live="polite">
      {t.copyPrompt}
    </button>
  </div>
  <div class="prose prompt-body">
    <Content />
  </div>
</section>
