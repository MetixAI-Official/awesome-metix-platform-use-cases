---
/*
 * A report chapter: the site's split header (title on the left, note on the right, one rule
 * under the full column), opened by a large numeral in the accent with the chapter's figures
 * beside it. The title comes first in the DOM so heading navigation lands on it; CSS puts the
 * numeral row above. Figures inside a chapter pass level={3}.
 */
import { chapterFigures, type Lang } from "@site/i18n";

interface Props {
  lang: Lang;
  id: string;
  part: number;
  title: string;
  note: string;
  figures: string[];
}

const { lang, id, part, title, note, figures } = Astro.props;
---

<header class="shelf-head chapter" id={id}>
  <h2>{title}</h2>
  <p class="ch-kicker">
    <span class="ch-num" aria-hidden="true">{part}</span>
    <span class="visually-hidden">{lang === "zh" ? `第 ${part} 部分，` : `Part ${part}, `}</span>
    <span>{chapterFigures(lang, figures)}</span>
  </p>
  <p class="ch-note">{note}</p>
</header>
