---
/*
 * A figure's reading, inside its card between the chart and the source line, across the
 * card's full content width. Two parts with fixed roles and places: what the figure shows
 * on the left, its method and limits on the right, at one size and leading so the lines
 * of both columns share baselines. On phones they stack.
 *
 * A term that names a mark in the chart can carry that mark's swatch, written in the text
 * as {{kind|words}}. Kinds: hl (the highlight color), line (the solid reference line),
 * dash (the dashed reference line), hatch (hatched bars), open and filled (dots). The text
 * is escaped first, so only these keys become markup; an unknown kind fails the build.
 */
import type { Lang } from "@site/i18n";

interface Props {
  lang: Lang;
  /** One string per paragraph. */
  shows: string | string[];
  method: string | string[];
}

const { lang, shows, method } = Astro.props;

const KINDS = new Set(["hl", "line", "dash", "hatch", "open", "filled"]);
const escape = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
// Chinese breaks between any two characters, so a short quoted term ("不适用") is kept whole.
// This runs on the escaped text, before any markup exists, so it never touches an attribute.
const keepQuotes = (s: string) => (lang === "zh" ? s.replace(/"([^"<>{}|]{1,12})"/g, '<span class="nowrap">"$1"</span>') : s);
const render = (s: string) => {
  const html = keepQuotes(escape(s)).replace(/\{\{(\w+)\|([^{}]+)\}\}/g, (_, kind: string, words: string) => {
    if (!KINDS.has(kind)) throw new Error(`FigNotes: unknown key kind "${kind}"`);
    return `<span class="k k-${kind}">${words}</span>`;
  });
  if (html.includes("{{") || html.includes("}}")) throw new Error(`FigNotes: malformed key in "${s.slice(0, 80)}"`);
  return html;
};

const paras = (v: string | string[]) => (Array.isArray(v) ? v : [v]).map(render);
const parts = [
  { label: lang === "zh" ? "图中所见" : "What it shows", paras: paras(shows) },
  { label: lang === "zh" ? "方法与局限" : "Method and limits", paras: paras(method) },
];
---

<div class="fig-notes">
  {
    parts.map((p) => (
      <div class="fn-part">
        <p class="fn-label">{p.label}</p>
        <div class="fn-text">
          {p.paras.map((html) => (
            <p set:html={html} />
          ))}
        </div>
      </div>
    ))
  }
</div>
