---
/*
 * The reading of a figure, directly under it and aligned with the figure's content edge,
 * so it reads as that figure's caption: a label naming the figure, then the text at a
 * reading measure. The first paragraph is what the figure shows; any after it carry method
 * and caveats, at the same size.
 */
import type { Lang } from "@site/i18n";

interface Props {
  lang: Lang;
  figure: string;
  paras: string[];
}

const { lang, figure, paras } = Astro.props;
---

<div class="fig-notes">
  <p class="fn-label">{lang === "zh" ? `关于图 ${figure}` : `About figure ${figure}`}</p>
  <div class="fn-text">
    {paras.map((p) => <p>{p}</p>)}
  </div>
</div>
