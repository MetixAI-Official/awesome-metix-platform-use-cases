---
/* A chart with its finding as the heading, a text alternative, its notes (the "notes" slot,
   FigNotes), a source line, and its queries. */
import QueryDetails, { type QueryItem } from "@site/components/QueryDetails.astro";
import { titleHtml, type Lang } from "@site/i18n";

interface Props {
  id: string;
  lang: Lang;
  heading: string;
  sub?: string;
  alt: string;
  source: string;
  queries?: QueryItem[];
  cost?: string;
  number?: string;
  /** 3 inside a report chapter, so the outline reads chapter, then figure. */
  level?: 2 | 3;
}

const { id, lang, heading, sub, alt, source, queries, cost, number, level = 2 } = Astro.props;
const Heading = level === 3 ? "h3" : "h2";
---

<figure class="fig" id={id} aria-labelledby={`${id}-title`} aria-describedby={`${id}-alt`}>
  <figcaption>
    {number && <p class="fig-number">{number}</p>}
    <Heading class="fig-title" id={`${id}-title`} set:html={titleHtml(heading, lang)} />
    {sub && <p class="fig-sub">{sub}</p>}
    <p class="visually-hidden" id={`${id}-alt`}>{alt}</p>
  </figcaption>
  <div class="fig-chart"><slot /></div>
  <slot name="notes" />
  <div class="fig-foot">
    <p class="fig-source">{source}</p>
    {queries && <QueryDetails lang={lang} items={queries} />}
  </div>
</figure>
