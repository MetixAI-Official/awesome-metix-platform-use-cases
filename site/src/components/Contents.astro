---
/*
 * The parts of a long report as one strip across the full column, after In brief: each part
 * is a link with its number, title, and figures, so a reader can see the report's shape and
 * jump to a part. It stacks on phones. start numbers the first part, for a report in stages
 * whose later strip continues the count.
 */
import type { Lang } from "@site/i18n";

export interface Part {
  id: string;
  title: string;
  figures: string[];
}

interface Props {
  lang: Lang;
  parts: Part[];
  start?: number;
}

const { lang, parts, start = 1 } = Astro.props;
---

<nav class="contents" aria-label={lang === "zh" ? "本报告的各部分" : "Parts of this report"}>
  <ol>
    {
      parts.map((p, i) => (
        <li>
          <a href={`#${p.id}`}>
            <span class="ct-title">{p.title}</span>
            <span class="ct-part">{lang === "zh" ? `第 ${start + i} 部分` : `Part ${start + i}`}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
