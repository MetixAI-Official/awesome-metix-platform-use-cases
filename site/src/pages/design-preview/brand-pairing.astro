---
import "@fontsource-variable/sora";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import BrandPairing from "@site/components/BrandPairing.astro";
import PlatformSignature from "@site/components/PlatformSignature.astro";
import { asset, REPO } from "@site/i18n";
const preview = asset("design-preview/compare/?mode=split&lang=en&device=desktop");
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Casebook · 新品牌组合预览</title>
  </head>
  <body>
    <main>
      <header class="intro">
        <div><p class="eyebrow">BRAND PAIRING / 04</p><h1>同一个品牌，两种组合。</h1><p class="lead">保留官方 Logo，新增横向 Platform 组合。右侧新样式已应用到优化版导航。</p></div>
        <a class="back" href={preview}>页面配色对比 ↗</a>
      </header>

      <div class="logo-options">
        <section class="hero-board" aria-label="现有栏目组合">
          <div class="board-top"><span>01 / 栏目组合</span><span>Casebook</span></div>
          <div class="signature-stage"><BrandPairing /></div>
          <div class="board-caption"><span class="caption-rule" aria-hidden="true"></span><p>品牌与栏目分层，适合 Casebook 的独立展示。</p></div>
        </section>
        <section class="hero-board platform-option" aria-label="新增横向 Logo 组合">
          <div class="board-top"><span>02 / 横向组合</span><span class="new-label">新增 · 已应用</span></div>
          <div class="signature-stage"><PlatformSignature /></div>
          <div class="board-caption"><span class="caption-rule" aria-hidden="true"></span><p>官方 Logo、细分隔线与 Platform 同轴排列，轻盈而清晰。</p></div>
        </section>
      </div>

      <section class="desktop-preview" aria-labelledby="desktop-label">
        <h2 id="desktop-label">03 / 新样式 · 桌面导航</h2>
        <div class="browser-shell">
          <div class="navigation">
            <a class="brand-link" href={asset("design-preview/optimized/en/")}><PlatformSignature /></a>
            <nav aria-label="导航应用示例"><a class="lang" href={asset("design-preview/optimized/en/")}>EN</a><a href={asset("design-preview/optimized/zh/")}>中文</a><a href={REPO}>GitHub</a><a class="api-link" href="https://platform.metix.ai/api-keys">Get an API key</a></nav>
          </div>
          <div class="context-strip"><span>Casebook</span><p>Research, findings, and the data behind them.</p><span class="context-note">RESEARCH / CASEBOOK</span></div>
        </div>
      </section>

      <div class="detail-grid">
        <section aria-labelledby="mobile-label">
          <h2 id="mobile-label">04 / 新样式 · 手机导航 · 375 px</h2>
          <div class="phone">
            <div class="phone-brand"><PlatformSignature /></div>
            <nav class="phone-nav" aria-label="手机导航应用示例"><a href={REPO}>GitHub ↗</a><span><a href={asset("design-preview/optimized/zh/")}>中文</a><a class="api-link" href="https://platform.metix.ai/api-keys">API key</a></span></nav>
            <div class="phone-body"><p>Metix AI Platform</p><strong>Casebook</strong><hr /><p>Job-market questions answered by AI agents, with findings you can reproduce.</p></div>
          </div>
        </section>
        <section class="design-notes" aria-labelledby="notes-label">
          <h2 id="notes-label">搭配细节</h2>
          <dl><div><dt>完整的官方标识</dt><dd>保留官方青绿到蓝紫的渐变图标，以及原有 Metix AI 字标。</dd></div><div><dt>同轴排列，精细间距</dt><dd>细分隔线连接品牌与产品名；Platform 使用轻量等宽字，Casebook 保留在页面标题中。</dd></div><div><dt>克制的品牌色</dt><dd>渐变集中在品牌图标，灰紫色产品名与浅色分隔线衬托主标识。</dd></div></dl>
          <div class="swatches" aria-label="品牌配色"><span style="--swatch:#100d35">深海军蓝</span><span style="--swatch:#5b54ef">品牌紫</span><span style="--swatch:#d4f5ea">浅青绿</span></div>
        </section>
      </div>
      <footer><span>独立搭配预览</span><a href={preview}>查看原版与优化版页面 ↗</a></footer>
    </main>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f5f7fb; color: #100d35; font-family: "Geist Variable", "PingFang SC", sans-serif; }
  :global(a:focus-visible) { outline: 2px solid #5b54ef; outline-offset: 5px; }
  p, h1, h2, dl, dd { margin: 0; }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  main { max-width: 1240px; margin: auto; padding: 48px 40px 30px; }
  .intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
  .eyebrow { font: 500 10px/1.5 "Geist Mono Variable", monospace; color: #5147b5; letter-spacing: .09em; }
  h1 { font-size: clamp(25px, 3vw, 34px); line-height: 1.35; letter-spacing: -.035em; font-weight: 550; margin-top: 13px; }
  .lead { font-size: 14px; line-height: 1.8; color: #55536e; margin-top: 12px; }
  .back { font-size: 12px; white-space: nowrap; padding-bottom: 5px; color: #494181; }
  .hero-board { background: #fff; border: 1px solid #e1e2ef; border-radius: 16px; overflow: hidden; }
  .logo-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .logo-options .hero-board { display: flex; flex-direction: column; }
  .logo-options .board-caption { flex: 1; }
  .platform-option .signature-stage { background: #f5f7fb; }
  .platform-option .caption-rule { background: linear-gradient(90deg, #0defc8, #1e79c2 70%, #5b54ef); }
  .new-label { color: #137568; }
  @media (max-width: 1000px) { .logo-options { grid-template-columns: 1fr; } }
  .board-top { display: flex; justify-content: space-between; gap: 16px; padding: 20px 26px; color: #65627b; font: 11px/1.5 "Geist Variable", sans-serif; }
  .signature-stage { min-height: 225px; display: grid; place-items: center; padding: 24px; }
  .board-caption { display: flex; align-items: center; gap: 14px; background: #eeeffa; padding: 18px 26px; color: #45445d; font-size: 12px; line-height: 1.7; }
  .caption-rule { width: 24px; height: 3px; flex-shrink: 0; background: #5b54ef; }
  h2 { font-size: 12px; font-weight: 500; line-height: 1.5; color: #55536e; margin-bottom: 13px; }
  .desktop-preview { margin-top: 30px; }
  .browser-shell { border: 1px solid #e1e2ef; border-radius: 12px; overflow: hidden; background: #fff; }
  .navigation { display: flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 104px; padding: 22px 30px; }
  .brand-link { display: inline-flex; text-decoration: none; }
  nav { display: flex; align-items: center; gap: 19px; font-size: 12px; }
  .lang { color: #494181; }
  .api-link { display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; padding: 11px 16px; background: #d4f5ea; color: #07545e; font-size: 12px; font-weight: 550; white-space: nowrap; }
  .context-strip { display: flex; align-items: center; gap: 20px; padding: 22px 30px; background: #f1f3fa; border-top: 1px solid #e7e7f0; }
  .context-strip > span:first-child { font: 700 19px/1.2 "Sora Variable", sans-serif; letter-spacing: -.04em; }
  .context-strip p { color: #65627b; font-size: 12px; }
  .context-note { margin-left: auto; color: #65627b; font: 9px/1.5 "Geist Mono Variable", monospace; letter-spacing: .04em; }
  .detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; margin-top: 32px; }
  .phone { width: 375px; max-width: 100%; background: #fff; border: 1px solid #dedfeb; border-radius: 16px; overflow: hidden; }
  .phone-brand { display: flex; align-items: center; justify-content: center; padding: 24px 16px 20px; }
  .phone-nav { display: flex; justify-content: space-between; padding: 0 20px 16px; }
  .phone-nav > span { display: flex; align-items: center; gap: 18px; }
  .phone-nav .api-link { padding: 9px 14px; }
  .phone-body { padding: 24px 20px 28px; background: #f1f3fa; border-top: 1px solid #e5e6ef; }
  .phone-body > p:first-child { color: #55536e; font: 10px/1.5 "Geist Mono Variable", monospace; }
  .phone-body strong { display: block; font: 700 47px/1.1 "Sora Variable", sans-serif; letter-spacing: -.06em; margin-top: 14px; }
  hr { border: 0; border-top: 1px solid #b9bad7; margin: 17px 0; }
  .phone-body > p:last-child { font-size: 13px; line-height: 1.8; color: #45445d; }
  .design-notes { padding-top: 1px; }
  dl > div { padding: 16px 0; border-bottom: 1px solid #e1e2eb; }
  dt { font-size: 14px; font-weight: 550; }
  dd { color: #55536e; font-size: 13px; line-height: 1.8; margin-top: 7px; }
  .swatches { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 22px; }
  .swatches > span { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; color: #55536e; }
  .swatches > span::before { content: ""; width: 13px; height: 13px; border-radius: 50%; background: var(--swatch); border: 1px solid #100d3515; }
  footer { display: flex; justify-content: space-between; gap: 16px; margin-top: 32px; padding-top: 22px; border-top: 1px solid #e1e2eb; color: #65627b; font-size: 11px; }
  @media (max-width: 850px) { .navigation { flex-wrap: wrap; gap: 24px; } .context-note { display: none; } .detail-grid { gap: 32px; } }
  @media (max-width: 620px) { main { padding: 28px 16px 24px; } .intro { display: block; } .back { display: inline-block; margin-top: 14px; } .board-top { padding: 16px; font-size: 10px; } .board-top > span:last-child { display: none; } .signature-stage { min-height: 165px; padding: 20px 8px; } .board-caption { padding: 16px; align-items: flex-start; } .caption-rule { margin-top: 8px; } .navigation { padding: 22px 16px; } .navigation nav { flex-wrap: wrap; gap: 14px; } .context-strip { display: block; padding: 20px 16px; } .context-strip p { margin-top: 8px; line-height: 1.6; } .detail-grid { grid-template-columns: 1fr; } .phone { margin: auto; } footer { flex-wrap: wrap; } }
</style>
