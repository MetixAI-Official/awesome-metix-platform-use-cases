---
import "@fontsource-variable/sora";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import BrandPairing from "@site/components/BrandPairing.astro";
import PlatformSignature from "@site/components/PlatformSignature.astro";
import { asset, REPO } from "@site/i18n";
const preview = asset("design-preview/compare/?mode=unified&lang=zh&device=desktop");
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Metix AI · 品牌组合与应用</title>
  </head>
  <body>
    <main>
      <header class="intro">
        <div><p class="eyebrow">METIX AI / BRAND SYSTEM</p><h1>一个品牌，清晰的层级。</h1><p class="lead">Metix AI 是品牌，Platform 是产品，Casebook 是案例栏目。用一致的标识、间距和色彩连接彼此。</p></div>
        <a class="back" href={preview}>查看双站预览 ↗</a>
      </header>

      <div class="logo-options">
        <section class="hero-board" aria-label="现有栏目组合">
          <div class="board-top"><span><b>01</b> 栏目组合</span><span>Casebook</span></div>
          <div class="signature-stage"><BrandPairing /></div>
          <div class="board-caption"><span class="caption-rule" aria-hidden="true"></span><p>品牌与栏目分层，适合 Casebook 的独立展示。</p></div>
        </section>
        <section class="hero-board platform-option" aria-label="新增横向 Logo 组合">
          <div class="board-top"><span><b>02</b> 产品组合</span><span class="new-label">已统一应用</span></div>
          <div class="signature-stage"><PlatformSignature /></div>
          <div class="board-caption"><span class="caption-rule" aria-hidden="true"></span><p>品牌、分隔线与产品名沿视觉中线对齐，用于两站导航。</p></div>
        </section>
      </div>

      <section class="desktop-preview" aria-labelledby="desktop-label">
        <h2 id="desktop-label">03 / 应用 · 桌面导航</h2>
        <div class="browser-shell">
          <div class="navigation">
            <a class="brand-link" href={asset("design-preview/optimized/en/")}><PlatformSignature /></a>
            <nav aria-label="导航应用示例"><a class="lang" href={asset("design-preview/optimized/en/")}>EN</a><a href={asset("design-preview/optimized/zh/")}>中文</a><a href={REPO}>GitHub</a><a class="api-link" href="https://platform.metix.ai/api-keys">Get an API key</a></nav>
          </div>
          <div class="context-strip"><span>Casebook</span><p>Research, findings, and the data behind them.</p><span class="context-note">RESEARCH / CASEBOOK</span></div>
        </div>
      </section>

      <div class="detail-grid">
        <section aria-labelledby="mobile-label">
          <h2 id="mobile-label">04 / 应用 · 手机导航</h2>
          <div class="phone">
            <div class="phone-brand"><PlatformSignature /></div>
            <nav class="phone-nav" aria-label="手机导航应用示例"><a href={REPO}>GitHub ↗</a><span><a href={asset("design-preview/optimized/zh/")}>中文</a><a class="api-link" href="https://platform.metix.ai/api-keys">API key</a></span></nav>
            <div class="phone-body"><p>Metix AI Platform</p><strong>Casebook</strong><hr /><p>Job-market questions answered by AI agents, with findings you can reproduce.</p></div>
          </div>
        </section>
        <section class="design-notes" aria-labelledby="notes-label">
          <h2 id="notes-label">05 / 统一规则</h2>
          <dl><div><dt>完整的官方标识</dt><dd>保留官方青绿到蓝紫的渐变图标，以及原有 Metix AI 字标。</dd></div><div><dt>同一中线，同一节奏</dt><dd>Logo、分隔线与产品名居中对齐。Platform 使用轻量等宽字，Casebook 以栏目标题呈现。</dd></div><div><dt>同一色彩，不同角色</dt><dd>深海军蓝承载标题与主按钮，浅灰白形成阅读底色，青绿和品牌紫用于重点。</dd></div></dl>
          <div class="swatches" aria-label="品牌配色"><span style="--swatch:#100d35">深海军蓝</span><span style="--swatch:#5b54ef">品牌紫</span><span style="--swatch:#d4f5ea">浅青绿</span></div>
        </section>
      </div>
      <footer><span>Metix AI · Platform · Casebook</span><a href={preview}>查看统一风格页面 ↗</a></footer>
    </main>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f6f8fb; color: #100d35; font-family: "Geist Variable", "PingFang SC", sans-serif; }
  :global(a:focus-visible) { outline: 2px solid #5b54ef; outline-offset: 5px; }
  p, h1, h2, dl, dd { margin: 0; }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  main { max-width: 1240px; margin: auto; padding: 64px 40px 36px; }
  .intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 36px; }
  .eyebrow { font: 500 10px/1.5 "Geist Mono Variable", monospace; color: #657086; letter-spacing: .12em; }
  h1 { font-size: clamp(28px, 3.2vw, 40px); line-height: 1.35; letter-spacing: -.035em; font-weight: 550; margin-top: 13px; }
  .lead { max-width: 48em; font-size: 14px; line-height: 1.8; color: #657086; margin-top: 12px; }
  .back { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; white-space: nowrap; padding: 12px 16px; color: #100d35; border: 1px solid #e1e6ef; border-radius: 999px; background: #fff; }
  .back:hover { background: #edf4f7; text-decoration: none; }
  .hero-board { background: #fff; border: 1px solid #e1e6ef; border-radius: 22px; box-shadow: 0 12px 30px -26px #100d3530; overflow: hidden; }
  .logo-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .logo-options .hero-board { display: flex; flex-direction: column; }
  .logo-options .board-caption { flex: 1; }
  .platform-option .signature-stage { background: radial-gradient(ellipse at 65% 55%,#f1f8f9,transparent 65%); }
  .platform-option .caption-rule { background: linear-gradient(90deg, #0defc8, #1e79c2 70%, #5b54ef); }
  .new-label { display: inline-flex; align-items: center; gap: 6px; color: #237766; background: #eaf7f2; border-radius: 999px; padding: 4px 10px; }
  .new-label::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: #2fa78c; }
  @media (max-width: 1000px) { .logo-options { grid-template-columns: 1fr; } }
  .board-top { min-height: 66px; align-items: center; display: flex; justify-content: space-between; gap: 16px; padding: 20px 26px; color: #65627b; font: 11px/1.5 "Geist Variable", sans-serif; }
  .signature-stage { min-height: 220px; display: grid; place-items: center; padding: 24px; }
  .board-top > span:first-child { display: flex; align-items: center; gap: 10px; }
  .board-top b { font: 11px/1 "Geist Mono Variable",monospace; color: #8a94a5; }
  .board-caption { border-top: 1px solid #eef1f5; display: flex; align-items: center; gap: 14px; background: #fafbfd; padding: 18px 26px; color: #45445d; font-size: 12px; line-height: 1.7; }
  .caption-rule { width: 18px; height: 2px; flex-shrink: 0; background: #5b54ef; }
  h2 { font-size: 12px; font-weight: 500; line-height: 1.5; color: #657086; margin-bottom: 13px; }
  .desktop-preview { margin-top: 36px; }
  .browser-shell { border: 1px solid #e1e6ef; border-radius: 20px; overflow: hidden; background: #fff; }
  .navigation { display: flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 96px; padding: 22px 30px; }
  .brand-link { display: inline-flex; text-decoration: none; }
  nav { display: flex; align-items: center; gap: 19px; font-size: 12px; }
  .lang { color: #494181; }
  .api-link { display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; padding: 11px 16px; background: #100d35; color: #fff; font-size: 12px; font-weight: 550; white-space: nowrap; }
  .context-strip { display: flex; align-items: center; gap: 20px; padding: 22px 30px; background: #f6f8fb; border-top: 1px solid #e7e7f0; }
  .context-strip > span:first-child { font: 700 19px/1.2 "Sora Variable", sans-serif; letter-spacing: -.04em; }
  .context-strip p { color: #65627b; font-size: 12px; }
  .context-note { margin-left: auto; color: #65627b; font: 9px/1.5 "Geist Mono Variable", monospace; letter-spacing: .04em; }
  .detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; margin-top: 32px; }
  .phone { width: 375px; max-width: 100%; background: #fff; border: 1px solid #e1e6ef; border-radius: 22px; box-shadow: 0 14px 28px -26px #100d3530; overflow: hidden; }
  .phone-brand { display: flex; align-items: center; justify-content: center; padding: 24px 16px 20px; }
  .phone-nav { display: flex; justify-content: space-between; padding: 0 20px 16px; }
  .phone-nav > span { display: flex; align-items: center; gap: 18px; }
  .phone-nav .api-link { padding: 9px 14px; }
  .phone-body { padding: 24px 20px 28px; background: #f6f8fb; border-top: 1px solid #e5e6ef; }
  .phone-body > p:first-child { color: #657086; font: 10px/1.5 "Geist Mono Variable", monospace; }
  .phone-body strong { display: block; font: 700 47px/1.1 "Sora Variable", sans-serif; letter-spacing: -.06em; margin-top: 14px; }
  hr { border: 0; border-top: 1px solid #dde4ef; margin: 17px 0; }
  .phone-body > p:last-child { font-size: 13px; line-height: 1.8; color: #45445d; }
  .design-notes { padding-top: 1px; }
  dl > div { padding: 16px 0; border-bottom: 1px solid #e1e6ef; }
  dt { font-size: 14px; font-weight: 550; }
  dd { color: #657086; font-size: 13px; line-height: 1.8; margin-top: 7px; }
  .swatches { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 22px; }
  .swatches > span { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; color: #657086; }
  .swatches > span::before { content: ""; width: 13px; height: 13px; border-radius: 50%; background: var(--swatch); border: 1px solid #100d3515; }
  footer { display: flex; justify-content: space-between; gap: 16px; margin-top: 32px; padding-top: 22px; border-top: 1px solid #e1e6ef; color: #65627b; font-size: 11px; }
  @media (max-width: 850px) { .navigation { flex-wrap: wrap; gap: 24px; } .context-note { display: none; } .detail-grid { gap: 32px; } }
  @media (max-width: 620px) { main { padding: 28px 16px 24px; } .intro { display: block; } .back { display: inline-block; margin-top: 14px; } .board-top { padding: 16px; font-size: 10px; } .board-top > span:last-child { font-size: 10px; } .signature-stage { min-height: 165px; padding: 20px 8px; } .board-caption { padding: 16px; align-items: flex-start; } .caption-rule { margin-top: 8px; } .navigation { padding: 22px 16px; } .navigation nav { flex-wrap: wrap; gap: 14px; } .context-strip { display: block; padding: 20px 16px; } .context-strip p { margin-top: 8px; line-height: 1.6; } .detail-grid { grid-template-columns: 1fr; } .phone { margin: auto; } footer { flex-wrap: wrap; } }
</style>
