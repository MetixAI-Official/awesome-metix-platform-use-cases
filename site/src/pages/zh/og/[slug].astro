---
import { getCollection } from "astro:content";
import OgCard from "@site/components/OgCard.astro";

export async function getStaticPaths() {
  const cases = await getCollection("cases", (c) => c.data.status === "published");
  return cases.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<OgCard lang="zh" entry={entry} />
