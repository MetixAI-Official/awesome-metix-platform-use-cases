---
/*
 * Design
 * Color follows data: a jobs report, so it lives in the jobs blue family, and it is the first
 *   report on the site to open light (the others open dark).
 * Hero: pale steel field #E6EEF7 and ink type. The door is blue: #145A93 for the families a
 *   heading names, #5A8ABF for the rest (3.1:1 on the field), empty squares white with a hairline.
 * Signature: the waffle wall. Twelve 10 by 10 grids, one per occupation, sorted from the
 *   narrowest door to the widest, so the whole finding reads as one ramp across the column.
 * Body: one 0 to 100% axis for every door chart. #145A93 for what a heading names, grey
 *   #858395 for the rest, and software's share as a dashed ink-2 reference wherever a chart
 *   compares to it.
 * Wording: entry level is only what a posting labels or asks for, never age. One day of
 *   postings, not a trend. Exposure groups are the cited paper's quintiles, not scores, and
 *   nothing here says exposure causes a narrow door.
 */
import BarList from "@site/components/charts/BarList.astro";
import FigNotes from "@site/components/charts/FigNotes.astro";
import Figure from "@site/components/charts/Figure.astro";
import { REPO, href, isoDate, longDate, number, titleHtml, type Lang } from "@site/i18n";
import familiesData from "../data/families.json";
import receipt from "../data/receipt.json";
import subgroupsData from "../data/subgroups.json";
import familiesQuery from "../queries/families.json";
import measuresQuery from "../queries/measures.json";

interface Props {
  lang: Lang;
  section: "card" | "body" | "method";
  size?: "compact" | "full";
  entry: {
    slug: string;
    title: Record<Lang, string>;
    dek: Record<Lang, string>;
    snapshot?: Date;
    exploration_credits?: number;
  };
}

const { lang, section, entry } = Astro.props;
const zh = lang === "zh";
const snapshot = entry.snapshot ?? new Date(familiesData.snapshot);
const iso = isoDate(snapshot);
const pct = (x: number, d = 1) => `${number(lang, x * 100, d)}%`;
const join = (items: string[]) =>
  zh ? items.join("、") : items.length < 3 ? items.join(" and ") : `${items.slice(0, -1).join(", ")}, and ${items[items.length - 1]}`;
const source = zh ? `来源：Metix AI Platform 岗位数据，${iso}。` : `Source: Metix AI Platform, jobs, ${iso}.`;
const queries = [
  { file: "families.json", endpoint: "POST /v1/jobs/query", spec: familiesQuery },
  { file: "measures.json", endpoint: "POST /v1/jobs/query", spec: measuresQuery },
];
const PAPER = "https://digitaleconomy.stanford.edu/publication/canaries-in-the-coal-mine-six-facts-about-the-recent-employment-effects-of-artificial-intelligence/";

type Row = (typeof familiesData.rows)[number];
const rows = familiesData.rows as Row[];
const fam = (g: string) => {
  const r = rows.find((x) => x.group === g);
  if (!r) throw new Error(`entry-door report: no family ${g}`);
  return r;
};
const sub = (g: string) => {
  const r = subgroupsData.rows.find((x) => x.group === g);
  if (!r) throw new Error(`entry-door report: no subgroup ${g}`);
  return r;
};
// The two doors, both computed from counts so a reader can check them against the data.
const ls = (r: { label_door_count: number; total_count: number }) => r.label_door_count / r.total_count;
const rq = (r: { stated_le24_count: number; stated_count: number }) => r.stated_le24_count / r.stated_count;
const cov = (r: Row) => r.stated_count / r.total_count;
const dis = (r: Row) => (r.label_only_count + r.requirement_only_count) / r.stated_count;
const withAssoc = (r: Row) => (r.label_door_count + r.associate_count) / r.total_count;
const intern = (r: Row) => r.internship_count / r.label_door_count;

const names: Record<string, Record<Lang, string>> = {
  ai: { en: "AI and machine learning", zh: "AI 与机器学习" },
  software: { en: "Software engineering", zh: "软件工程" },
  "data-analyst": { en: "Data analyst", zh: "数据分析师" },
  "financial-analyst": { en: "Financial analyst", zh: "财务分析师" },
  accountant: { en: "Accountant", zh: "会计" },
  paralegal: { en: "Paralegal and legal assistant", zh: "律师助理" },
  "graphic-designer": { en: "Graphic designer", zh: "平面设计师" },
  marketing: { en: "Marketing", zh: "市场营销" },
  "customer-service": { en: "Customer service", zh: "客户服务" },
  "registered-nurse": { en: "Registered nurse", zh: "注册护士" },
  electrician: { en: "Electrician", zh: "电工" },
  "truck-driver": { en: "Truck and CDL driver", zh: "卡车与 CDL 司机" },
};
const short: Record<string, Record<Lang, string>> = {
  ai: { en: "AI and ML", zh: "AI 与机器学习" },
  software: { en: "Software", zh: "软件工程" },
  paralegal: { en: "Paralegal", zh: "律师助理" },
  "truck-driver": { en: "Truck driver", zh: "卡车司机" },
};
const name = (g: string) => names[g][lang];
const sname = (g: string) => short[g]?.[lang] ?? name(g);
// A family name inside an English sentence: lower case, keeping AI and CDL.
const lower: Record<string, string> = { ai: "AI and machine learning", "truck-driver": "truck and CDL driver" };
const lc = (g: string) => (zh ? name(g) : (lower[g] ?? name(g).toLowerCase()));

const sw = fam("software");
const ai = fam("ai");
const cs = fam("customer-service");
const acc = fam("accountant");
const par = fam("paralegal");
const byLabel = [...rows].sort((a, b) => ls(a) - ls(b));
// The hero and figure 01 name software and AI; they must be the two narrowest by label.
if (new Set(byLabel.slice(0, 2).map((r) => r.group)).size !== 2 || !byLabel.slice(0, 2).every((r) => ["software", "ai"].includes(r.group))) {
  throw new Error("entry-door report: software and AI are no longer the two narrowest doors; rewrite the headings");
}
const narrowest = new Set(["software", "ai"]);
const others = rows.filter((r) => !narrowest.has(r.group));
const othersFloor = Math.floor(Math.min(...others.map(ls)) * 10) * 10;
const othersReqMin = Math.min(...others.map(rq));
const bothNarrowest = Math.max(rq(sw), rq(ai)) < othersReqMin;
const assocLowest = [...rows]
  .sort((a, b) => withAssoc(a) - withAssoc(b))
  .slice(0, 2)
  .every((r) => narrowest.has(r.group));
const times = ls(cs) / ls(sw);
const covMin = rows.reduce((a, b) => (cov(a) < cov(b) ? a : b));
const covMax = rows.reduce((a, b) => (cov(a) > cov(b) ? a : b));
const totalPostings = rows.reduce((s, r) => s + r.total_count, 0);
const aiTraining = sub("ai-training");

// Exposure groups, from the quintile the cited paper gives each family's closest occupation.
const groupOrder = ["[5]", "[4,5]", "[4]", "[3]", "[2]", "null"];
const groupLabel: Record<string, Record<Lang, string>> = {
  "[5]": { en: "Quintile 5, the most exposed", zh: "第 5 档，暴露度最高" },
  "[4,5]": { en: "Quintiles 4 and 5", zh: "第 4 档和第 5 档" },
  "[4]": { en: "Quintile 4", zh: "第 4 档" },
  "[3]": { en: "Quintile 3", zh: "第 3 档" },
  "[2]": { en: "Quintile 2", zh: "第 2 档" },
  null: { en: "Not in the paper's tables", zh: "不在论文的表中" },
};
const qKey = (r: Row) => JSON.stringify(r.paper_quintiles ?? null);
const groups = groupOrder
  .map((k) => ({ key: k, rows: rows.filter((r) => qKey(r) === k).sort((a, b) => ls(a) - ls(b)) }))
  .filter((g) => g.rows.length > 0);
if (groups.reduce((s, g) => s + g.rows.length, 0) !== rows.length) throw new Error("entry-door report: a family has an unknown quintile");
const q5 = groups.find((g) => g.key === "[5]")!.rows;
const q5Low = q5[0];
const q5High = q5[q5.length - 1];
const qTag = (r: Row) => {
  const q = r.paper_quintiles as number[] | null;
  return q ? q.map((n) => `Q${n}`).join(zh ? "、" : ", ") : "";
};
const exposureFocus = new Set([q5Low.group, q5High.group]);

// Figure 03: where the two measures disagree, most first.
const byDis = [...rows].sort((a, b) => dis(b) - dis(a));
const csMostlyReqOnly = cs.requirement_only_count > cs.label_only_count;
const naShare = cs.not_applicable_count / cs.total_count;
const widerByLabel = rows.filter((r) => ls(r) - rq(r) > 0.05).sort((a, b) => ls(b) - rq(b) - (ls(a) - rq(a)));
const widerByReq = rows.filter((r) => rq(r) - ls(r) > 0.05).sort((a, b) => rq(b) - ls(b) - (rq(a) - ls(a)));

// Figure 04: internships as a share of the label door, on a 0 to 30% scale.
const byIntern = [...rows].sort((a, b) => intern(b) - intern(a));
const internAxis = Math.ceil(Math.max(...rows.map(intern)) * 10) / 10;
const internLow = rows.filter((r) => intern(r) < 0.01).sort((a, b) => intern(a) - intern(b));

// Figure 05: the two widest doors without their largest special cases.
const rnTravel = sub("registered-nurse-travel");
const rnRest = sub("registered-nurse-not-travel");
const csRetail = sub("customer-service-retail-restaurants");
const csRest = sub("customer-service-outside-retail-restaurants");
const rn = fam("registered-nurse");
const robust = [
  {
    family: "registered-nurse",
    items: [
      { key: "travel", label: zh ? "标题含 travel" : "Travel titles", row: rnTravel, focus: false },
      { key: "rest", label: zh ? "其他护士岗位" : "Other nursing postings", row: rnRest, focus: true },
    ],
  },
  {
    family: "customer-service",
    items: [
      { key: "retail", label: zh ? "零售和餐饮雇主" : "Retail and restaurant employers", row: csRetail, focus: false },
      { key: "rest", label: zh ? "其他雇主" : "Other employers", row: csRest, focus: true },
    ],
  },
];
const x = (v: number) => `${(Math.min(1, Math.max(0, v)) * 100).toFixed(2)}%`;
const ticks = [0, 0.25, 0.5, 0.75, 1];
---

{section === "card" && null}

{
  section === "body" && (
    <>
      <header class="ed-hero">
        <div class="wrap">
          <div class="ed-top">
            <div class="ed-text">
              <nav class="ed-eyebrow" aria-label={zh ? "页面路径" : "Breadcrumb"}>
                <a href={href(lang)}>Casebook</a> <span aria-hidden="true">/</span>{" "}
                <a href={`${href(lang)}?format=report#index`}>{zh ? "报告" : "Reports"}</a>
              </nav>
              <p class="ed-meta">
                {zh ? "报告" : "Report"} · <a href={`${href(lang)}?data=jobs#index`}>{zh ? "岗位" : "Jobs"}</a> ·{" "}
                <span class="nowrap">{iso}</span>
              </p>
              <h1 set:html={titleHtml(entry.title[lang], lang)} />
              <p class="ed-dek">{entry.dek[lang]}</p>
              <div class="ed-actions">
                <a class="ed-chip" href="#run">{zh ? "运行这个案例" : "Run it"}</a>
                <a class="ed-chip" href="#run-reproduce">
                  {zh ? `复现需 ${receipt.credits} Credits` : `${receipt.credits} Credits to reproduce`}
                </a>
                <span class="ed-note">{zh ? "复现只计数，不读取任何岗位" : "Reproducing reads no postings: every number is a count"}</span>
              </div>
            </div>
            <div class="ed-side">
            <dl class="ed-pair">
              <div class="focus">
                <dt>{pct(ls(sw))}</dt>
                <dd>
                  {zh
                    ? "美国在招的软件工程岗位中，标为实习或入门级的比例"
                    : "of open US software engineering postings are labelled Internship or Entry level "}
                  <span class="nowrap">
                    {zh
                      ? `（${number(lang, sw.total_count)} 个中 ${number(lang, sw.label_door_count)} 个）`
                      : `(${number(lang, sw.label_door_count)} of ${number(lang, sw.total_count)})`}
                  </span>
                </dd>
              </div>
              <div>
                <dt>{pct(ls(cs))}</dt>
                <dd>
                  {zh
                    ? "客户服务岗位的同一比例"
                    : "in customer service "}
                  <span class="nowrap">
                    {zh
                      ? `（${number(lang, cs.total_count)} 个中 ${number(lang, cs.label_door_count)} 个）`
                      : `(${number(lang, cs.label_door_count)} of ${number(lang, cs.total_count)})`}
                  </span>
                  {zh
                    ? `；零售和餐饮之外的雇主是 ${pct(ls(csRest))}`
                    : `; ${pct(ls(csRest))} at employers outside retail and restaurants`}
                </dd>
              </div>
            </dl>
            <p class="ed-pair-note">
              {zh
                ? "下文引用的论文把软件开发和客户服务都列在 AI 暴露度最高的五分之一职业里。"
                : "The paper cited below puts both software developers and customer service representatives in its most AI-exposed fifth of occupations."}
            </p>
            </div>
          </div>

          <div class="ed-wall-head">
            <p
              class="ed-wall-title"
              id="wall-title"
              set:html={titleHtml(
                zh ? "每 100 个在招岗位里，有几个标为实习或入门级" : "Of every 100 open postings, how many are labelled Internship or Entry level",
                lang,
              )}
            />
            <p class="ed-wall-key" aria-hidden="true">
              <span class="wk on">{zh ? "标为入门" : "Labelled entry"}</span>
              <span class="wk hl">{zh ? "页面标题提到的" : "Named in the page title"}</span>
              <span class="wk off">{zh ? "其他" : "Any other label"}</span>
              <span class="wk q">{zh ? "Q = 论文中的暴露度档位" : "Q = exposure quintile in the paper"}</span>
            </p>
          </div>
          <ol class="wall" aria-labelledby="wall-title">
            {byLabel.map((r) => {
              const filled = Math.round(ls(r) * 100);
              return (
                <li class:list={["waffle", { focus: narrowest.has(r.group) }]}>
                  <span class="wf-grid" aria-hidden="true">
                    {Array.from({ length: 100 }, (_, i) => {
                      const fromBottom = (9 - Math.floor(i / 10)) * 10 + (i % 10);
                      return <span class={fromBottom < filled ? "on" : undefined} />;
                    })}
                  </span>
                  <span class="wf-val">{pct(ls(r))}</span>
                  <span class="wf-name">{sname(r.group)}</span>
                  {qTag(r) && (
                    <span class="wf-q">
                      <span class="visually-hidden">{zh ? "论文中的暴露度档位 " : "Exposure quintile in the paper: "}</span>
                      {qTag(r)}
                    </span>
                  )}
                </li>
              );
            })}
          </ol>
        </div>
      </header>

      <div class="wrap report-body">
        <section class="text-block rail-block" aria-labelledby="who-title">
          <div class="rail">
            <h2 id="who-title">{zh ? "统计的是什么" : "What is counted"}</h2>
          </div>
          <div class="rail-main">
            <dl class="criteria">
              {(zh
                ? [
                    ["岗位", `${longDate(lang, snapshot)} Metix AI Platform 上地点在美国、仍在招聘的岗位。数的是岗位，不是空缺，也不是录用。`, null],
                    ["职业", `按标题里的词定义十二个职业族，例如 software engineer、registered nurse，合计 ${number(lang, totalPostings)} 个岗位。每个岗位最多算进一个职业族；标题同时含 AI 词和 trainer、tutor、annotator、annotation 或 rater 的岗位（${number(lang, aiTraining.total_count)} 个）不计入任何职业族。`, null],
                    ["标签口径", "岗位的资历标签是实习（Internship）或入门级（Entry level）。来源平台给每个岗位都设了资历标签，所以这个比例覆盖全部岗位。", null],
                    ["要求口径", `岗位要求 24 个月以内的工作经验（含 0），占写明经验要求的岗位的比例。各职业族写明要求的比例从 ${pct(cov(covMin))}（${name(covMin.group)}）到 ${pct(cov(covMax))}（${name(covMax.group)}）不等。`, null],
                    ["暴露度分档", "来自 Brynjolfsson、Chandar 和 Chen 的论文（斯坦福数字经济实验室，2026 年 8 月修订版）的附录表格，按 Eloundou 等人的 GPT-4 暴露度指标分为五档，第 5 档最高。论文只给档位，不给分数；每个职业族对应论文列出的最接近的职业。", PAPER],
                    ["不做推断", "入门只看岗位怎么标、要求多少经验。数据里没有年龄，这里也不涉及最终录用了谁。", null],
                  ]
                : [
                    ["Postings", `Open job postings located in the United States, on the Metix AI Platform on ${longDate(lang, snapshot)}. Counts are postings, not openings, and not hires.`, null],
                    ["Occupations", `Twelve families defined by words in the title, such as software engineer or registered nurse: ${number(lang, totalPostings)} postings in all. Each posting counts in one family at most, and titles that pair an AI term with trainer, tutor, annotator, annotation, or rater (${number(lang, aiTraining.total_count)}) are left out of every family.`, null],
                    ["Label door", "The posting's seniority is Internship or Entry level. The source sets a seniority on every posting, so this share covers all of them.", null],
                    ["Requirement door", `The posting asks for 24 months of experience or less, 0 included, as a share of the postings that state a requirement. How many state one runs from ${pct(cov(covMin))} in the ${lc(covMin.group)} family to ${pct(cov(covMax))} in the ${lc(covMax.group)} family.`, null],
                    ["Exposure groups", "Quintiles from Brynjolfsson, Chandar, and Chen (Stanford Digital Economy Lab, August 2026 revision), set by the GPT-4 exposure measure of Eloundou and colleagues; quintile 5 is the most exposed. The paper gives quintiles, not scores, and each family stands for the closest occupation the paper lists.", PAPER],
                    ["Never inferred", "Entry level is only what a posting labels or asks for. The data has no ages, and nothing here says who is hired.", null],
                  ]
              ).map(([term, text, link]) => (
                <div>
                  <dt>{term}</dt>
                  <dd>
                    {text}
                    {link && (
                      <>
                        {" "}
                        <a href={link}>{zh ? "论文页面" : "The paper"}</a>
                      </>
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </section>

        <section class="text-block rail-block" aria-labelledby="brief-title">
          <div class="rail">
            <h2 id="brief-title">{zh ? "要点" : "In brief"}</h2>
          </div>
          <div class="rail-main">
            <ol class="brief-list">
              {(zh
                ? [
                    `软件工程和 AI 职位按两种口径都最窄：标为实习或入门级的分别是 ${pct(ls(sw))} 和 ${pct(ls(ai))}，写明经验要求的岗位里，要求 24 个月以内的分别是 ${pct(rq(sw))} 和 ${pct(rq(ai))}。其他职业族按标签都在 ${othersFloor}% 以上。`,
                    `论文列为 AI 暴露度最高的五分之一职业，并不都这么窄。客户服务是 ${pct(ls(cs))}，是软件的 ${number(lang, times, 1)} 倍；会计和律师助理分别是 ${pct(ls(acc))} 和 ${pct(ls(par))}。`,
                    `在写明经验要求的岗位里，两种口径在客户服务上有 ${pct(dis(cs))} 不一致，在软件上只有 ${pct(dis(sw))}${csMostlyReqOnly ? "；客户服务的不一致大多是要求很少经验、却标成了别的资历" : ""}。`,
                    `去掉旅行护士岗位和零售、餐饮雇主之后，宽的依然宽：其他护士岗位是 ${pct(ls(rnRest))}，其他客户服务岗位是 ${pct(ls(csRest))}，软件是 ${pct(ls(sw))}。`,
                  ]
                : [
                    `Software engineering and AI titles have the narrowest door by both measures: ${pct(ls(sw))} and ${pct(ls(ai))} are labelled Internship or Entry level, and ${pct(rq(sw))} and ${pct(rq(ai))} of those that state a requirement ask for 24 months or less. Every other family is above ${othersFloor}% by label.`,
                    `The narrow door is not shared by every occupation the cited paper puts in its most AI-exposed fifth. Customer service is at ${pct(ls(cs))}, ${number(lang, times, 1)} times software, and accountants and paralegals are at ${pct(ls(acc))} and ${pct(ls(par))}.`,
                    `Where a posting states a requirement, the two measures disagree on ${pct(dis(cs))} of customer service postings and ${pct(dis(sw))} of software's${csMostlyReqOnly ? ", in customer service mostly postings that ask for little experience under another label" : ""}.`,
                    `Leaving out travel nursing titles and retail and restaurant employers keeps the wide doors wide: ${pct(ls(rnRest))} for other nursing postings and ${pct(ls(csRest))} for other customer service postings, against ${pct(ls(sw))} in software.`,
                  ]
              ).map((text) => (
                <li>
                  <span set:html={zh ? titleHtml(text, "zh") : text} />
                </li>
              ))}
            </ol>
          </div>
        </section>

        <Figure
          id="doors"
          lang={lang}
          number="01"
          heading={
            zh
              ? bothNarrowest
                ? "按两种口径，软件工程和 AI 职位留给新人的比例都最低"
                : "按标签口径，软件工程和 AI 职位留给新人的比例最低"
              : bothNarrowest
                ? "Software and AI titles have the narrowest entry door by both measures"
                : "Software and AI titles have the narrowest entry door by label"
          }
          sub={
            zh
              ? "条形：标为实习或入门级的岗位比例。圆点：写明经验要求的岗位里，要求 24 个月以内的比例；右列是写明要求的岗位占比。刻度 0 到 100%"
              : "Bar: share of open US postings labelled Internship or Entry level. Dot: share of postings stating an experience requirement that ask for 24 months or less; the last column is how many state one. Axis 0 to 100%"
          }
          alt={byLabel
            .map((r) =>
              zh
                ? `${name(r.group)}：标签 ${pct(ls(r))}，要求 ${pct(rq(r))}，写明要求 ${pct(cov(r), 0)}`
                : `${name(r.group)}: label ${pct(ls(r))}, requirement ${pct(rq(r))}, ${pct(cov(r), 0)} state one`,
            )
            .join(zh ? "；" : "; ")}
          source={source}
          queries={queries}
        >
          <p class="legend" slot="legend" aria-hidden="true">
            <span class="lg lg-bar">{zh ? "标为实习或入门级" : "Labelled Internship or Entry level"}</span>
            <span class="lg lg-dot">{zh ? "要求 24 个月以内" : "Asks for 24 months or less"}</span>
            <span class="lg lg-hl">{zh ? "标题提到的" : "Named in the title"}</span>
          </p>
          <div class="dr" aria-hidden="true">
            <div class="dr-head">
              <span />
