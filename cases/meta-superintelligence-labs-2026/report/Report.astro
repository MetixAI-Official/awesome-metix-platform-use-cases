const placeName: Record<string, Record<Lang, string>> = {
  "bay-area": { en: "San Francisco Bay Area", zh: "旧金山湾区" },
  "new-york": { en: "New York State", zh: "纽约州" },
  washington: { en: "Washington State", zh: "华盛顿州" },
  "california-other": { en: "Elsewhere in California", zh: "加州其他地区" },
  "us-other": { en: "Elsewhere in the US, or no state", zh: "美国其他地区，或未写州" },
  "united-kingdom": { en: "United Kingdom", zh: "英国" },
  "elsewhere-or-none": { en: "Elsewhere, or no country", zh: "其他国家，或未写国家" },
};
// US places by size, the US remainder, then abroad.
const placeOrder = ["bay-area", "new-york", "washington", "california-other", "us-other", "united-kingdom", "elsewhere-or-none"];
const placeRows = placeOrder.map((g) => place(g));
if (placeRows.length !== placesData.rows.length) throw new Error("Meta report: a place row is missing from placeOrder");
const placeShare = (g: string) => num(place(g).count, g) / total;
const posting = (g: string) => num(row(postingsData.rows, g, "posting").count, `posting ${g}`);
