// Stage-2 shares are stored rounded to four places, and rounding one again for display can land
// a step off (329 of 936 is 35.1496%, stored as 0.3515, which would print 35.2%). Every share that
// has its count is recomputed from the count and its base before anything is drawn.
type Rec = Record<string, unknown>;
const reshare = <T extends Rec>(rows: T[], baseOf: (r: T, prefix: string) => unknown): T[] =>
  rows.map((r) => {
    const out: Rec = { ...r };
    for (const k of Object.keys(r)) {
      if (!k.endsWith("_share")) continue;
      const p = k.slice(0, -"_share".length);
      const c = r[`${p}_count`];
      const b = baseOf(r, p);
      if (typeof c === "number" && typeof b === "number" && b > 0) out[k] = c / b;
    }
    return out as T;
  });
// Files that compare the lab with the rest: the groups are the bases unless a row names its own.
const labRest = <F extends { lab_count: number; rest_count: number; rows: Rec[] }>(f: F): F => ({
  ...f,
  rows: reshare(f.rows, (r, p) => (p === "lab" ? (r.lab_base_count ?? f.lab_count) : p === "rest" ? (r.rest_base_count ?? f.rest_count) : undefined)),
});
const mapDirections = labRest(mapDirectionsRaw);
const mapFunctions = labRest(mapFunctionsRaw);
const mapLevels = labRest(mapLevelsRaw);
const mapSources = labRest(mapSourcesRaw);
const mapTitles = labRest(mapTitlesRaw);
// Units: shares within the unit, except China-educated, which is of those listing a bachelor's.
const mapUnits = { ...mapUnitsRaw, rows: reshare(mapUnitsRaw.rows, (r, p) => (p === "china_educated" ? r.bachelor_count : r.count)) };

