// ---------- teams, places, postings (figures 07 to 09)
function teamsAtMostOf(rows: typeof teamsData.rows) {
  return rows.filter((r) => r.group !== "fair-only").reduce((s, r) => s + (typeof r.count === "number" ? r.count : 9), 0);
}
const teamRows = teamsData.rows
  .filter((r) => r.group !== "fair-only")
  .sort((a, b) => (typeof b.count === "number" ? b.count : 0.5) - (typeof a.count === "number" ? a.count : 0.5));
// "at least" is a lower bound, so it rounds down.
const noneAtLeast = `${number(lang, Math.floor((1 - teamsAtMostOf(teamsData.rows) / teamsData.total_count) * 100))}%`;
const fairOnly = num(row(teamsData.rows, "fair-only", "team").count, "FAIR only");
const fair = row(teamRows, "fair", "team");
const teamsAtMost = teamsAtMostOf(teamsData.rows);
if (teamsAtMost / total >= 1 / 6) throw new Error("Meta report: a sixth or more may name a group; rewrite figure 07");
const teamName: Record<string, Record<Lang, string>> = {
