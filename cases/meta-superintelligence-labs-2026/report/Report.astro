  infra: { en: "MSL Infra and other infrastructure", zh: "MSL Infra 及其他基础设施" },
  "tbd-lab": { en: "TBD Lab", zh: "TBD Lab" },
  par: { en: "Products and Applied Research", zh: "Products and Applied Research" },
};
