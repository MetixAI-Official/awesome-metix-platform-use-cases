// ================= stage 2: the map =================
// Color keeps one meaning per group: lab violet, the rest of Meta's AI staff gray, Meta's AI
// postings blue, and a warm tone only for people who left Meta.
// Each figure shows only the parts of mapping.json it rests on.
const PEOPLE = "POST /v1/people/query";
const JOBS = "POST /v1/jobs/query";
const q2 = (endpoint: string, ...parts: (keyof typeof mappingQuery)[]) => [
  { file: `mapping.json (${parts.join(", ")})`, endpoint, spec: Object.fromEntries(parts.map((k) => [k, mappingQuery[k]])) },
];
const sourceBoth = zh ? `来源：Metix AI Platform 个人档案与岗位数据，${iso}。` : `Source: Metix AI Platform, profiles and jobs, ${iso}.`;
