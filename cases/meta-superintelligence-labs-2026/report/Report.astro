---
/*
 * Design
 * Color follows cohort. Violet #3D36C9 marks people who were at Meta when the lab formed, the
 *   group the title names; pale violet #8E88E6 people who had worked at Meta before but not
 *   then; ink #0B0A1F people new to Meta; grey #858395 context. A profiles report, so it stays in
 *   the violet family, and it opens on white, unlike the two dark violet reports.
 * Signature: the 936. One strip of 936 hairlines, one per person, in three blocks, with the
 *   lab's founding at the point where the first block ends. Two rows on wide screens, three below
 *   1200px, four on tablets, eight on phones, so a mark never drops much under 1.5px.
 * Body: figure 01 draws first joins as a rate per year, so bands of different lengths compare,
 *   in two panels split at the founding: by year before it, by month after it.
 * Wording: the population is people who chose to name the lab, a lower bound and not the lab.
 *   Neutral verbs for moves (join, leave, return, hire). No one is named.
 */
import BarList from "@site/components/charts/BarList.astro";
import Chapter from "@site/components/Chapter.astro";
import Contents from "@site/components/Contents.astro";
import FigNotes from "@site/components/charts/FigNotes.astro";
import Figure from "@site/components/charts/Figure.astro";
import { REPO, href, isoDate, longDate, number, titleHtml, type Lang } from "@site/i18n";
import cohortsData from "../data/cohorts.json";
import firstData from "../data/first_joined.json";
import movesData from "../data/moves.json";
import placesData from "../data/places.json";
import postingsData from "../data/postings.json";
import receipt from "../data/receipt.json";
import rolesData from "../data/roles.json";
import sourcesData from "../data/sources.json";
import teamsData from "../data/teams.json";
import measuresQuery from "../queries/measures.json";
import populationQuery from "../queries/population.json";

interface Props {
  lang: Lang;
  section: "card" | "body" | "method";
  size?: "compact" | "full";
  entry: {
    slug: string;
    title: Record<Lang, string>;
    dek: Record<Lang, string>;
    snapshot?: Date;
    exploration_credits?: number;
  };
}

const { lang, section, entry } = Astro.props;
const zh = lang === "zh";
const snapshot = entry.snapshot ?? new Date(cohortsData.snapshot);
const iso = isoDate(snapshot);
const pct = (x: number, d = 1) => `${number(lang, x * 100, d)}%`;
const n = (x: number) => number(lang, x);
const source = zh ? `来源：Metix AI Platform 个人档案数据，${iso}。` : `Source: Metix AI Platform, profiles, ${iso}.`;
const sourceJobs = zh ? `来源：Metix AI Platform 岗位数据，${iso}。` : `Source: Metix AI Platform, jobs, ${iso}.`;
const queries = [
  { file: "population.json", endpoint: "POST /v1/people/query", spec: populationQuery },
  { file: "measures.json", endpoint: "POST /v1/people/query · POST /v1/jobs/query", spec: measuresQuery },
];
const MEMO = "https://www.cnbc.com/2025/06/30/mark-zuckerberg-creating-meta-superintelligence-labs-read-the-memo.html";
const SCALE = "https://axios.com/2025/06/13/meta-scale-ai-deal";
const MSFT = "https://www.cnbc.com/2025/11/06/microsoft-forms-superintelligence-team-under-ai-head-mustafa-suleyman-.html";

// A published count of people can be "<10"; every number a sentence uses must be a real count.
const num = (v: number | string, what: string): number => {
  if (typeof v !== "number") throw new Error(`Meta report: ${what} is suppressed (${v}); rewrite the text that uses it`);
  return v;
};
const row = <T extends { group: string }>(rows: T[], group: string, what: string): T => {
  const r = rows.find((x) => x.group === group);
  if (!r) throw new Error(`Meta report: no ${what} row ${group}`);
  return r;
};

// ---------- cohorts
const cohort = (lab: string, definition: string, group: string) => {
  const r = cohortsData.rows.find((x) => x.lab === lab && x.definition === definition && x.group === group);
  if (!r) throw new Error(`Meta report: no cohort ${lab} ${definition} ${group}`);
  return num(r.count, `${lab} ${group}`);
};
const total = cohortsData.meta_total_count;
const stayed = cohort("meta", "superintelligence-or-msl", "stayed");
const returned = cohort("meta", "superintelligence-or-msl", "returned");
const interns = cohort("meta", "superintelligence-or-msl", "former-interns");
const fresh = cohort("meta", "superintelligence-or-msl", "new-to-employer");
const hadBeen = returned + interns;
const outside = cohortsData.meta_outside_count;
if (stayed + hadBeen + fresh !== total || hadBeen + fresh !== outside) throw new Error("Meta report: cohorts do not add up");
// The title and the hero say most were already at Meta.
if (stayed / total < 0.5) throw new Error("Meta report: those who stayed are no longer a majority; rewrite the title");
const narrowTotal = cohortsData.meta_superintelligence_only_total_count;
const narrowStayed = cohort("meta", "superintelligence-only", "stayed");
const msTotal = cohortsData.microsoft_total_count;
const msBefore = cohort("microsoft", "superintelligence", "earlier-job-at-employer");

// ---------- first joins (figure 01): a rate per year so bands of different lengths compare
const DAY = 864e5;
const YEAR = 365.25 * DAY;
const T0 = Date.parse("2014-01-01");
const CUT = Date.parse(firstData.cut);
const EDGE = Date.parse("2026-05-01"); // profiles stop in April 2026 (see Limits)
type Band = { from: string | null; before: string | null; count: number; a: number; b: number; rate: number };
const bands: Band[] = firstData.rows
  .filter((r) => r.series === "meta-any-entry")
  .map((r) => {
    const count = num(r.count, `first-join band ${r.group}`);
    const a = r.from ? Date.parse(r.from) : Number.NEGATIVE_INFINITY;
    const b = r.before ? Date.parse(r.before) : EDGE;
    return { from: r.from, before: r.before, count, a, b, rate: Number.isFinite(a) ? count / ((b - a) / YEAR) : 0 };
  });
const openBand = bands.find((b) => !Number.isFinite(b.a));
if (!openBand || openBand.b !== T0) throw new Error("Meta report: the first band no longer ends in 2014; move T0");
const beforeBands = bands.filter((b) => Number.isFinite(b.a) && b.b <= CUT);
const afterBands = bands.filter((b) => b.a >= CUT);
const everBefore = openBand.count + beforeBands.reduce((s, b) => s + b.count, 0);
if (everBefore + afterBands.reduce((s, b) => s + b.count, 0) !== total) throw new Error("Meta report: first-join bands do not add up");
const maxRate = Math.max(...bands.map((b) => b.rate));
const yMax = Math.ceil(maxRate / 100) * 100;
const yTicks = Array.from({ length: yMax / 100 + 1 }, (_, i) => i * 100);
const h = (rate: number) => `${(rate / yMax) * 100}%`;
const xBefore = (t: number) => `${((t - T0) / (CUT - T0)) * 100}%`;
const xAfter = (t: number) => `${((t - CUT) / (EDGE - CUT)) * 100}%`;
const wBefore = (b: Band) => `calc(${((b.b - b.a) / (CUT - T0)) * 100}% - 2px)`;
const wAfter = (b: Band) => `calc(${((b.b - b.a) / (EDGE - CUT)) * 100}% - 2px)`;
const beforeTicks = [2014, 2016, 2018, 2020, 2022, 2024].map((y) => ({ t: Date.parse(`${y}-01-01`), label: String(y), yr: "", mid: false }));
// The after panel is narrow: a tick's year hides first, then the middle tick (container queries on .mx-sky-panel.after).
const afterTicks = [
  { t: CUT, label: zh ? "6 月" : "Jun", yr: zh ? "2025 年 " : " 2025", mid: false },
  { t: Date.parse("2025-10-01"), label: zh ? "10 月" : "Oct", yr: "", mid: true },
  { t: Date.parse("2026-01-01"), label: zh ? "1 月" : "Jan", yr: zh ? "2026 年 " : " 2026", mid: false },
];
// Where half the group had first joined, from the cumulative counts.
let cum = openBand.count;
const medianBand = beforeBands.find((b) => (cum += b.count) >= total / 2);
if (!medianBand) throw new Error("Meta report: half the group first joined after the lab formed; rewrite figure 01");
const medianYear = new Date(medianBand.a).getUTCFullYear();
// 2024 as one calendar year, the last full year before the lab, for the monthly comparison in figure 01's note.
const y2024 = bands.find((b) => b.from === "2024-01-01" && b.before === "2025-01-01");
if (!y2024) throw new Error("Meta report: 2024 is no longer one band; rewrite figure 01's note");

// ---------- moves (figure 03) and the newcomers' months
const moves = movesData.rows.filter((r) => r.series === "stayed-newest-current-role");
const movesBefore = moves.filter((r) => !r.from || Date.parse(r.from) < CUT);
const movesAfter = moves.filter((r) => r.from && Date.parse(r.from) >= CUT);
const movedAfter = movesAfter.reduce((s, r) => s + num(r.count, r.group), 0);
const movedBySummerEnd = movesAfter.filter((r) => r.before && Date.parse(r.before) <= Date.parse("2025-09-01")).reduce((s, r) => s + num(r.count, r.group), 0);
const newcomers = movesData.rows.filter((r) => r.series === "new-to-meta-first-job");
const summer = newcomers.filter((r) => r.before && Date.parse(r.before) <= Date.parse("2025-10-01")).reduce((s, r) => s + num(r.count, r.group), 0);
const summerMonths = 4; // June to September 2025, the window of summer
const monthName = (d: string, withYear: boolean) => {
  const t = new Date(d);
  const m = t.getUTCMonth();
  return zh ? `${withYear ? `${t.getUTCFullYear()} 年 ` : ""}${m + 1} 月` : `${["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][m]}${withYear ? ` ${t.getUTCFullYear()}` : ""}`;
};
// A period from its first month to the month before `before`; the year is written once when both ends share it.
const spanLabel = (from: string, before: string | null) => {
  if (!before) return zh ? `${monthName(from, true)}起` : `Since ${monthName(from, true)}`;
  const end = new Date(Date.parse(before) - DAY).toISOString().slice(0, 10);
  if (from.slice(0, 7) === end.slice(0, 7)) return monthName(from, true);
  const sameYear = from.slice(0, 4) === end.slice(0, 4);
  return zh ? `${monthName(from, true)}到 ${monthName(end, !sameYear)}` : `${monthName(from, !sameYear)} to ${monthName(end, true)}`;
};
const moveLabel = (r: { from: string | null; before: string | null }) =>
  r.from ? spanLabel(r.from, r.before) : zh ? "2025 年以前，或没有日期" : "Before 2025, or no date";

// ---------- where outside hires came from (figure 04)
const cameFrom = sourcesData.rows.filter((r) => r.set === "came-from");
const ever = sourcesData.rows.filter((r) => r.set === "ever-worked-at");
const aiLabs = sourcesData.ai_labs_count;
const deepmind = num(row(cameFrom, "google-deepmind", "source").count, "Google DeepMind");
const uni = num(row(cameFrom, "academia", "source").count, "universities");
const scale = num(row(cameFrom, "scale-ai", "source").count, "Scale AI");
const cfScale = 0.5; // the came-from bars are shares of the outside hires on a 0 to 50% axis
const sourceLabel: Record<string, Record<Lang, string>> = {
  openai: { en: "OpenAI", zh: "OpenAI" },
  "google-deepmind": { en: "Google DeepMind", zh: "Google DeepMind" },
  anthropic: { en: "Anthropic", zh: "Anthropic" },
  xai: { en: "xAI", zh: "xAI" },
  "thinking-machines": { en: "Thinking Machines Lab", zh: "Thinking Machines Lab" },
  apple: { en: "Apple", zh: "Apple" },
  "scale-ai": { en: "Scale AI", zh: "Scale AI" },
  google: { en: "Google, other than Google DeepMind", zh: "Google（Google DeepMind 以外）" },
  microsoft: { en: "Microsoft", zh: "Microsoft" },
  amazon: { en: "Amazon", zh: "Amazon" },
  nvidia: { en: "NVIDIA", zh: "NVIDIA" },
  academia: { en: "A university or other educational institution", zh: "大学或其他教育机构" },
  other: { en: "Another employer, or none that ended in 2025 or later", zh: "其他雇主，或没有 2025 年或以后结束的工作" },
};
type Src = (typeof cameFrom)[number];
const srcRow = (r: Src, focus: boolean) => {
  const suppressed = typeof r.count !== "number";
  const c = typeof r.count === "number" ? r.count : 9;
  return {
    label: sourceLabel[r.group][lang],
    display: suppressed ? "<10" : typeof r.count === "number" && r.count > 0 ? `${n(r.count)} · ${pct(r.count / outside)}` : "0",
    width: c / outside / cfScale,
    kind: suppressed ? ("suppressed" as const) : r.group === "other" ? ("residual" as const) : focus && c > 0 ? ("focus" as const) : ("other" as const),
  };
};
const byCount = (a: Src, b: Src) => (typeof b.count === "number" ? b.count : 0.5) - (typeof a.count === "number" ? a.count : 0.5);
const labRows = cameFrom.filter((r) => r.ai_lab).sort(byCount).map((r) => srcRow(r, true));
const elseRows = [
  ...cameFrom.filter((r) => !r.ai_lab && r.group !== "other").sort(byCount),
  row(cameFrom, "other", "source"),
].map((r) => srcRow(r, false));
const otherShare = num(row(cameFrom, "other", "source").count, "other") / outside;
const everOf = (g: string) => num(row(ever, g, "ever-worked-at").count, `ever ${g}`);

// ---------- roles (figures 05 and 06)
const fnRows = rolesData.rows.filter((r) => r.table === "function");
const fnName: Record<string, Record<Lang, string>> = {
  research: { en: "Research", zh: "研究" },
  "engineering-and-technical": { en: "Engineering and technical", zh: "工程与技术" },
  product: { en: "Product", zh: "产品" },
  other: { en: "Another function", zh: "其他职能" },
  "not-stated": { en: "None stated", zh: "未写明" },
};
const fn = (g: string) => row(fnRows, g, "function");
const research = fn("research");
const engineering = fn("engineering-and-technical");
const phdRows = rolesData.rows.filter((r) => r.table === "doctorate");
const phd = (g: string) => row(phdRows, g, "doctorate");
const levelRows = rolesData.rows.filter((r) => r.table === "level-in-research");
const level = (g: string) => row(levelRows, g, "level");
const prMax = 0.6;
const prX = (s: number) => `${(s / prMax) * 100}%`;
type Pair = { name: string; stayed: number; outside: number; divider?: boolean };
const pairs: Pair[] = [
  ...fnRows.map((r) => ({ name: fnName[r.group][lang], stayed: num(r.stayed_share, r.group), outside: num(r.outside_share, r.group) })),
  { name: zh ? "写有博士学历" : "Lists a doctorate", stayed: phd("stayed").share, outside: phd("outside").share, divider: true },
];
const labPhd = phd("lab-research");
const basePhd = phd("baseline-research");

// ---------- teams, places, postings (figures 07 to 09)
function teamsAtMostOf(rows: typeof teamsData.rows) {
  return rows.filter((r) => r.group !== "fair-only").reduce((s, r) => s + (typeof r.count === "number" ? r.count : 9), 0);
}
const teamRows = teamsData.rows
  .filter((r) => r.group !== "fair-only")
  .sort((a, b) => (typeof b.count === "number" ? b.count : 0.5) - (typeof a.count === "number" ? a.count : 0.5));
// "at least" is a lower bound, so it rounds down.
const noneAtLeast = `${number(lang, Math.floor((1 - teamsAtMostOf(teamsData.rows) / teamsData.total_count) * 100))}%`;
const fairOnly = num(row(teamsData.rows, "fair-only", "team").count, "FAIR only");
const fair = row(teamRows, "fair", "team");
const teamsAtMost = teamsAtMostOf(teamsData.rows);
if (teamsAtMost / total >= 1 / 6) throw new Error("Meta report: a sixth or more may name a group; rewrite figure 07");
const teamName: Record<string, Record<Lang, string>> = {
  fair: { en: "FAIR", zh: "FAIR" },
  infra: { en: "MSL Infra and other infrastructure", zh: "MSL Infra 及其他基础设施" },
  "tbd-lab": { en: "TBD Lab", zh: "TBD Lab" },
  par: { en: "Products and Applied Research", zh: "Products and Applied Research" },
};
const place = (g: string) => row(placesData.rows, g, "place");
const placeName: Record<string, Record<Lang, string>> = {
  "bay-area": { en: "San Francisco Bay Area", zh: "旧金山湾区" },
  "new-york": { en: "New York State", zh: "纽约州" },
  washington: { en: "Washington State", zh: "华盛顿州" },
  "california-other": { en: "Elsewhere in California", zh: "加州其他地区" },
  "us-other": { en: "Elsewhere in the US, or no state", zh: "美国其他地区，或未写州" },
  "united-kingdom": { en: "United Kingdom", zh: "英国" },
  "elsewhere-or-none": { en: "Elsewhere, or no country", zh: "其他国家，或未写国家" },
};
// US places by size, the US remainder, then abroad.
const placeOrder = ["bay-area", "new-york", "washington", "california-other", "us-other", "united-kingdom", "elsewhere-or-none"];
const placeRows = placeOrder.map((g) => place(g));
if (placeRows.length !== placesData.rows.length) throw new Error("Meta report: a place row is missing from placeOrder");
const placeShare = (g: string) => num(place(g).count, g) / total;
const posting = (g: string) => num(row(postingsData.rows, g, "posting").count, `posting ${g}`);
const openAll = posting("all");
const menlo = posting("menlo-park");
const postingPlaces = [
  { g: "menlo-park", en: "Menlo Park", zh: "Menlo Park" },
  { g: "san-francisco", en: "San Francisco", zh: "旧金山" },
  { g: "new-york", en: "New York", zh: "纽约" },
  { g: "other-locations", en: "Elsewhere", zh: "其他地点" },
];
// Ticks for a bar scale that stops short of 100%: its start, middle, and end.
const axis = (max: number) => [0, max / 2, max].map((v) => ({ at: v / max, label: pct(v, 0) }));

// ---------- the signature strip: one mark per person in three blocks, column-major, so each
// block is one run from left to right at every row count and the founding line sits where the
// first block ends. Each row of a block is one dashed line whose pattern repeats once per
// column, so every mark is drawn the same width instead of snapping to one or two pixels.
const blocks = [
  { cls: "st", from: 0, to: stayed },
  { cls: "hb", from: stayed, to: stayed + hadBeen },
  { cls: "nw", from: stayed + hadBeen, to: total },
];
const stripLayouts = [
  { rows: 2, h: 30, gap: 6 },
  { rows: 3, h: 24, gap: 6 },
  { rows: 4, h: 22, gap: 6 },
  { rows: 8, h: 12, gap: 4 },
].map(({ rows, h, gap }) => {
  // Mark i sits in column floor(i / rows), row i % rows; colAt is the first column in row r whose mark index reaches k.
  const colAt = (k: number, r: number) => Math.max(0, Math.ceil((k - r) / rows));
  const lines = blocks.flatMap((b) =>
    Array.from({ length: rows }, (_, r) => ({ cls: b.cls, y: r * (h + gap) + h / 2, x1: colAt(b.from, r), x2: colAt(b.to, r) })).filter(
      (l) => l.x2 > l.x1,
    ),
  );
  return { rows, h, cols: Math.ceil(total / rows), height: rows * h + (rows - 1) * gap, lines };
});
const cutAt = stayed / total;

const parts = [
  {
    id: "part-already",
    figures: ["01", "02", "03"],
    title: zh ? "已在 Meta 的人" : "Already at Meta",
    note: zh
      ? "写明实验室的人最早何时加入 Meta，这个比例在两种口径下和在 Microsoft 是否一样，以及从 2025 年 6 月起谁记录了新职位。"
      : "When the people who name the lab first joined Meta, whether the share holds under two definitions and at Microsoft, and who recorded a new role from June 2025, the month it formed.",
  },
  {
    id: "part-outside",
    figures: ["04", "05"],
    title: zh ? "从外部加入的人" : "From outside",
    note: zh
      ? `${n(outside)} 名外部加入者刚离开的雇主，以及他们的职能和已在 Meta 的人有什么不同。`
      : `Where the ${n(outside)} outside hires had just worked, and how their roles differ from those already at Meta.`,
  },
  {
    id: "part-lab",
    figures: ["06", "07", "08", "09"],
    title: zh ? "实验室现在的样子" : "The lab now",
    note: zh
      ? "研究人员的博士学历、大家写明的团队、所在地，以及快照当天仍在招聘的岗位。"
      : "Doctorates among its researchers, the groups people name, where they are, and the postings open on the day of the snapshot.",
  },
];
---

{section === "card" && null}

{
  section === "body" && (
    <>
      <header class="mx-hero">
        <div class="wrap">
          <div class="mx-top">
            <div class="mx-text">
              <nav class="mx-eyebrow" aria-label={zh ? "页面路径" : "Breadcrumb"}>
                <a href={href(lang)}>Casebook</a> <span aria-hidden="true">/</span>{" "}
                <a href={`${href(lang)}?format=report#index`}>{zh ? "报告" : "Reports"}</a>
              </nav>
              <p class="mx-meta">
                {zh ? "报告" : "Report"} ·{" "}
                <a href={`${href(lang)}?data=people#index`}>{zh ? "个人档案" : "Profiles"}</a> ·{" "}
                <span class="nowrap">{iso}</span>
              </p>
              <h1 set:html={titleHtml(entry.title[lang], lang)} />
              <p class="mx-dek" set:html={titleHtml(entry.dek[lang], lang)} />
              <div class="mx-actions">
                <a class="mx-chip" href="#run">{zh ? "运行这个案例" : "Run it"}</a>
                <a class="mx-chip" href="#run-reproduce">
                  {zh ? `复现需 ${receipt.credits} Credits` : `${receipt.credits} Credits to reproduce`}
                </a>
                <span class="mx-note">{zh ? "复现只计数，不读取任何个人档案" : "Reproducing reads no profiles: every number is a count"}</span>
              </div>
            </div>
            <div class="mx-side">
              <dl class="mx-pair">
                <div class="stay">
                  <dt>{n(stayed)}</dt>
                  <dd
                    set:html={titleHtml(
                      zh
                        ? `${n(total)} 人中，2025 年 6 月实验室成立时已在 Meta 工作的人数（${pct(stayed / total)}）`
                        : `of the ${n(total)} were at Meta when the lab formed in June 2025 (${pct(stayed / total)})`,
                      lang,
                    )}
                  />
                </div>
                <div class="new">
                  <dt>{n(aiLabs)}</dt>
                  <dd
                    set:html={titleHtml(
                      zh
                        ? `从外部加入的 ${n(outside)} 人中，刚离开五家 AI 实验室之一的人数（${pct(aiLabs / outside)}）`
                        : `of the ${n(outside)} who joined from outside had just left one of five AI labs (${pct(aiLabs / outside)})`,
                      lang,
                    )}
                  />
                </div>
              </dl>
              <p class="mx-pair-note">
                {zh ? (
                  <>
                    Meta 在 2025 年 6 月 30 日
                    <a href={MEMO}>宣布成立该实验室</a>
                    时，把现有的 AI 团队（包括 FAIR）并入其中，所以实验室里本来就会有很多老员工。个人档案显示的是有多少，以及谁是新加入的。
                  </>
                ) : (
                  <>
                    Meta put its existing AI teams, FAIR among them, into the lab when it <a href={MEMO}>announced it</a> on June 30,
                    2025, so many long-time staff were always going to be in it. The profiles show how many, and who came in.
                  </>
                )}
              </p>
            </div>
          </div>

