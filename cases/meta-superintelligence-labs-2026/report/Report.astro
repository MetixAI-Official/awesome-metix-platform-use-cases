const menlo = posting("menlo-park");
const postingPlaces = [
  { g: "menlo-park", en: "Menlo Park", zh: "Menlo Park" },
  { g: "san-francisco", en: "San Francisco", zh: "旧金山" },
  { g: "new-york", en: "New York", zh: "纽约" },
  { g: "other-locations", en: "Elsewhere", zh: "其他地点" },
];
// Ticks for a bar scale that stops short of 100%: its start, middle, and end.
const axis = (max: number) => [0, max / 2, max].map((v) => ({ at: v / max, label: pct(v, 0) }));

// ---------- the signature strip: one mark per person in three blocks, column-major, so each
// block is one run from left to right at every row count and the founding line sits where the
// first block ends. Each row of a block is one dashed line whose pattern repeats once per
// column, so every mark is drawn the same width instead of snapping to one or two pixels.
const blocks = [
  { cls: "st", from: 0, to: stayed },
  { cls: "hb", from: stayed, to: stayed + hadBeen },
  { cls: "nw", from: stayed + hadBeen, to: total },
];
const stripLayouts = [
  { rows: 2, h: 30, gap: 6 },
  { rows: 3, h: 24, gap: 6 },
  { rows: 4, h: 22, gap: 6 },
  { rows: 8, h: 12, gap: 4 },
].map(({ rows, h, gap }) => {
  // Mark i sits in column floor(i / rows), row i % rows; colAt is the first column in row r whose mark index reaches k.
  const colAt = (k: number, r: number) => Math.max(0, Math.ceil((k - r) / rows));
  const lines = blocks.flatMap((b) =>
    Array.from({ length: rows }, (_, r) => ({ cls: b.cls, y: r * (h + gap) + h / 2, x1: colAt(b.from, r), x2: colAt(b.to, r) })).filter(
      (l) => l.x2 > l.x1,
    ),
  );
  return { rows, h, cols: Math.ceil(total / rows), height: rows * h + (rows - 1) * gap, lines };
});
const cutAt = stayed / total;

const parts = [
  {
    id: "part-already",
    figures: ["01", "02", "03"],
    title: zh ? "已在 Meta 的人" : "Already at Meta",
    note: zh
      ? "写明实验室的人最早何时加入 Meta，这个比例在两种口径下和在 Microsoft 是否一样，以及从 2025 年 6 月起谁记录了新职位。"
