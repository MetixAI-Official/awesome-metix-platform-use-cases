---
/*
 * Design
 * Color follows data: postings are jobs blue, profiles violet (see docs/style.md).
 * Hero: deep violet-navy #14112E, white type; demand in sky #A3E4FF, supply in lilac #9A95FF.
 * Body on white: demand in deep jobs blue #145A93, supply in violet #5B54EF, context in grey #858395.
 * Type: the shell faces; the ratio in Sora 700 at 120 px on desktop.
 * Signature: the two-sided chart. Profiles grow left, postings grow right, from one spine,
 *   so demand and supply for every tool are read on the same scale at a glance.
 */
import BarList from "@site/components/charts/BarList.astro";
import Chapter from "@site/components/Chapter.astro";
import Contents from "@site/components/Contents.astro";
import FigNotes from "@site/components/charts/FigNotes.astro";
import Figure from "@site/components/charts/Figure.astro";
import { REPO, href, isoDate, longDate, number, titleHtml, type Lang } from "@site/i18n";
import coMentions from "../data/co-mentions.json";
import countries from "../data/countries.json";
import demand from "../data/demand.json";
import industries from "../data/industries.json";
import pay from "../data/pay.json";
import receipt from "../data/receipt.json";
import supply from "../data/supply.json";
import dimensions from "../queries/dimensions.json";
import tools from "../queries/tools.json";

interface Props {
  lang: Lang;
  section: "card" | "body" | "method";
  size?: "compact" | "full";
  entry: {
    slug: string;
    title: Record<Lang, string>;
    dek: Record<Lang, string>;
    snapshot?: Date;
    exploration_credits?: number;
  };
}

const { lang, section, entry } = Astro.props;
const zh = lang === "zh";
const snapshot = entry.snapshot ?? new Date(demand.snapshot);
const iso = isoDate(snapshot);
const source = zh ? `来源：Metix AI Platform 岗位与个人档案数据，${iso}。` : `Source: Metix AI Platform, jobs and profiles, ${iso}.`;
const toolQuery = [{ file: "tools.json", endpoint: "POST /v1/jobs/query · POST /v1/people/query", spec: tools }];
const dimQuery = [
  { file: "tools.json", endpoint: "POST /v1/jobs/query", spec: tools },
  { file: "dimensions.json", endpoint: "POST /v1/jobs/query", spec: dimensions },
];
const cost = zh ? `整份报告 ${receipt.credits} Credits` : `${receipt.credits} Credits for the whole report`;

const names: Record<string, string> = {
  "claude-code": "Claude Code",
  cursor: "Cursor",
  "github-copilot": "GitHub Copilot",
  codex: "Codex",
  windsurf: "Windsurf",
  langchain: "LangChain",
  langgraph: "LangGraph",
  mcp: "Model Context Protocol",
  llamaindex: "LlamaIndex",
  crewai: "CrewAI",
  autogen: "AutoGen",
  dspy: "DSPy",
};
const num = (v: number | string) => (typeof v === "number" ? v : null);
const pct = (x: number, d = 0) => `${number(lang, x * 100, d)}%`;
const times = (x: number) => `${number(lang, x, x < 1 ? 2 : 1)}×`;

const unambiguous = tools.tools.filter((t) => t.unambiguous).map((t) => t.id);
const dem = (id: string) => demand.rows.find((r) => r.group === id)!;
const sup = (id: string) => supply.rows.find((r) => r.group === id)!;

type Pair = { id: string; d: number; s: number; dUs: number; sUs: number };
const pairs: Pair[] = unambiguous
  .map((id) => ({
    id,
    d: dem(id).count,
    s: num(sup(id).count) ?? 0,
    dUs: dem(id).us_count,
    sUs: num(sup(id).us_count) ?? 0,
  }))
  .sort((a, b) => b.d - a.d);
const sideMax = Math.max(...pairs.flatMap((p) => [p.d, p.s]));
const ratios = pairs.map((p) => ({ ...p, r: p.d / p.s })).sort((a, b) => b.r - a.r);
const leader = ratios[0];
const lowest = ratios[ratios.length - 1];
const secondLowest = ratios[ratios.length - 2];
const nearParity = ratios.filter((p) => p.r >= 0.9 && p.r <= 1.1).map((p) => names[p.id]);
const split = pairs
  .map((p) => ({ ...p, us: p.dUs / p.sUs, out: (p.d - p.dUs) / (p.s - p.sUs) }))
  .sort((a, b) => b.out - a.out);
const cc = split.find((p) => p.id === "claude-code")!;
// Figure 01's finding: the two largest tools on either side, and whether they lean opposite ways.
const biggest = [...ratios].sort((a, b) => Math.max(b.d, b.s) - Math.max(a.d, a.s)).slice(0, 2);
const opposite = (biggest[0].r - 1) * (biggest[1].r - 1) < 0;

// The report's four parts: the contents strip after In brief and each chapter header.
const parts = [
  {
    id: "part-supply",
    figures: ["01", "02", "03"],
    title: zh ? "岗位与档案对比" : "Postings against profiles",
    note: zh
      ? "每个工具的在招岗位数和把它列为技能的档案数，全球以及美国内外分开比较。"
      : "Each tool's open postings against the profiles that list it as a skill, worldwide and inside and outside the US.",
  },
  {
    id: "part-assistants",
    figures: ["04", "05"],
    title: zh ? "AI 编程助手" : "The coding assistants",
    note: zh ? "雇主点名每个助手的频率，以及哪些助手常被一起点名。" : "How often employers name each assistant, and which ones they name together.",
  },
  {
    id: "part-where",
    figures: ["06", "07"],
    title: zh ? "岗位在哪里" : "Where the postings are",
    note: zh ? "点名 AI 编程助手的岗位分布在哪些国家和行业。" : "The countries and industries of the postings that name an assistant.",
  },
  {
    id: "part-pay",
    figures: ["08"],
    title: zh ? "薪资" : "Pay",
    note: zh ? "在美国，点名 AI 编程助手的岗位写出的薪资下限是否更高。" : "Whether naming an assistant comes with a higher posted pay floor in the US.",
  },
];

// Log scale for postings per profile, shared by the ratio charts.
const LO = 0.25;
const HI = 10;
const pos = (v: number) => ((Math.log(v) - Math.log(LO)) / (Math.log(HI) - Math.log(LO))) * 100;
const ticks = [0.25, 0.5, 1, 2, 4, 8];

// Coding assistants.
const assistants = demand.rows.filter((r) => r.family === "assistant").sort((a, b) => b.count - a.count);
const anyAssistant = countries.world_count;
const strict = new Set(tools.tools.filter((t) => !t.unambiguous).map((t) => t.id));
const assistantRows = assistants.map((r) => ({
  label: names[r.group],
  note: strict.has(r.group) ? (zh ? "严格计数：需同时提到另一个工具" : "strict count: another tool named too") : undefined,
  display: `${number(lang, r.count)} · ${pct(r.count / anyAssistant)}`,
  width: r.count / anyAssistant,
  kind: r.group === "claude-code" ? ("focus" as const) : strict.has(r.group) ? ("lower" as const) : ("other" as const),
}));

// Notes mark the strict-count assistants with the hatch key, as their bars are hatched.
const noteName = (r: { group: string }) => (strict.has(r.group) ? `{{hatch|${names[r.group]}}}` : names[r.group]);

// Co-mentions: only rows whose own definition does not already require another tool.
const pairCount = (a: string, b: string) =>
  coMentions.rows.find((r) => r.group === `${a}+${b}` || r.group === `${b}+${a}`)?.count ?? 0;
const matrixRows = ["claude-code", "github-copilot"];
const matrixCols = assistants.map((r) => r.group);
const withCopilot = pairCount("claude-code", "github-copilot");

const ind = (g: string) => industries.rows.find((r) => r.group === g)?.count ?? 0;
const countryZh: Record<string, string> = {
  "United States": "美国",
  India: "印度",
  "United Kingdom": "英国",
  Germany: "德国",
  Canada: "加拿大",
  France: "法国",
  Netherlands: "荷兰",
  Singapore: "新加坡",
  Australia: "澳大利亚",
  Japan: "日本",
  "rest-of-world": "其他国家和地区",
};
const industryZh: Record<string, string> = {
  "IT Services and IT Consulting": "IT 服务与咨询",
  "Software Development": "软件开发",
  "Technology, Information and Internet": "科技、信息与互联网",
  "Financial Services": "金融服务",
  Banking: "银行",
  Insurance: "保险",
  Manufacturing: "制造业",
  "Hospitals and Health Care": "医院与医疗",
  Retail: "零售",
  Telecommunications: "电信",
  "Motor Vehicle Manufacturing": "汽车制造",
  "Higher Education": "高等教育",
  "Government Administration": "政府管理",
};
---

{section === "card" && null}

{
  section === "body" && (
    <>
      <header class="report-hero">
        <div class="wrap hero-grid">
          <div>
            <nav class="hero-eyebrow" aria-label={zh ? "页面路径" : "Breadcrumb"}>
              <a href={href(lang)}>Casebook</a> <span aria-hidden="true">/</span>{" "}
              <a href={`${href(lang)}?format=report#index`}>{zh ? "报告" : "Reports"}</a>
            </nav>
            <p class="hero-meta">
              {zh ? "报告" : "Report"} · <a href={`${href(lang)}?data=jobs#index`}>{zh ? "岗位" : "Jobs"}</a> ·{" "}
              <a href={`${href(lang)}?data=people#index`}>{zh ? "个人档案" : "Profiles"}</a> · <span class="nowrap">{iso}</span>
            </p>
            <h1 set:html={titleHtml(entry.title[lang], lang)} />
            <p class="hero-dek">{entry.dek[lang]}</p>
            <div class="hero-actions">
              <a class="hero-chip" href="#run">{zh ? "运行这个案例" : "Run it"}</a>
              <a class="hero-chip" href="#run-reproduce">
                {zh ? `复现需 ${receipt.credits} Credits` : `${receipt.credits} Credits to reproduce`}
              </a>
              <span class="hero-note">{zh ? "复现只计数，不读取任何记录" : "Reproducing reads no records: every number is a count"}</span>
            </div>
          </div>
          <div class="hero-key">
            <p class="key-num">
              {number(lang, leader.r, 1)}
              <span>×</span>
            </p>
            <p class="key-label">
              {zh
                ? `每个在技能里列出 Claude Code 的档案，对应 ${number(lang, leader.r, 1)} 个提到它的在招岗位（${number(lang, leader.d)} 比 ${number(lang, leader.s)}）。`
                : `open postings name Claude Code for every profile that lists it as a skill (${number(lang, leader.d)} to ${number(lang, leader.s)}).`}
            </p>
            <div class="key-scale" aria-hidden="true">
              <span class="ks-line" />
              <span class="ks-parity" style={`left: ${pos(1)}%`} />
              {[lowest, ratios.find((p) => p.id === "github-copilot")!, leader].map((p, i) => (
                <span
                  class:list={["ks-dot", { above: i === 1 }, p.r > 1.1 ? "lean-jobs" : p.r < 0.9 ? "lean-people" : "lean-even"]}
                  style={`left: ${pos(p.r)}%`}
                >
                  <span class="ks-name">{names[p.id]}</span>
                  <span class="ks-val">{times(p.r)}</span>
                </span>
              ))}
            </div>
            <p class="ks-caption">
              {zh
                ? "每个档案对应的岗位数，对数刻度。竖线是一比一，蓝点偏向岗位，淡紫点偏向档案。"
                : "Postings per profile, log scale. The tick is one to one; blue leans to postings, lilac to profiles."}
            </p>
          </div>
        </div>
      </header>

      <div class="wrap report-body">
        <section class="text-block rail-block" aria-labelledby="brief-title">
          <div class="rail">
            <h2 id="brief-title">{zh ? "要点" : "In brief"}</h2>
          </div>
          <div class="rail-main">
          <ol class="brief-list">
            {zh ? (
              [
                `九个名称不会有歧义的工具里，Claude Code 的缺口最大：${number(lang, leader.d)} 个在招岗位提到它，只有 ${number(lang, leader.s)} 个档案把它列为技能，每个档案对应 ${number(lang, leader.r, 1)} 个岗位。`,
                `${names[lowest.id]} 正好相反：${number(lang, lowest.s)} 个档案，${number(lang, lowest.d)} 个岗位。${names[secondLowest.id]} 也是档案多于岗位（${number(lang, secondLowest.s)} 比 ${number(lang, secondLowest.d)}）。`,
                `缺口在美国以外更大。Claude Code 在美国是每个档案 ${number(lang, cc.us, 1)} 个岗位，在美国以外是 ${number(lang, cc.out, 1)} 个。`,
                `提到 AI 编程工具不会抬高薪资下限：这类美国岗位里起薪 15 万美元以上的占 ${pct(pay.rows[0].at_least["150000"] / pay.rows[0].count)}，软件工程师岗位是 ${pct(pay.rows[1].at_least["150000"] / pay.rows[1].count)}。`,
              ].map((text) => (
                <li>
                  <span set:html={titleHtml(text, "zh")} />
                </li>
              ))
            ) : (
              <>
                <li>
                  Of nine tools whose names cannot mean anything else, Claude Code has the widest gap: {number(lang, leader.d)} open
                  postings name it and {number(lang, leader.s)} profiles list it, {number(lang, leader.r, 1)} postings per profile.
                </li>
                <li>
                  {names[lowest.id]} runs the other way, with {number(lang, lowest.s)} profiles to {number(lang, lowest.d)} postings.{" "}
                  {names[secondLowest.id]} does too: {number(lang, secondLowest.s)} profiles to {number(lang, secondLowest.d)} postings.
                </li>
                <li>
                  The gap is wider outside the US. For Claude Code it is {number(lang, cc.us, 1)} postings per profile in the US and{" "}
                  {number(lang, cc.out, 1)} everywhere else.
                </li>
                <li>
                  Naming a coding tool does not raise the posted pay floor: {pct(pay.rows[0].at_least["150000"] / pay.rows[0].count)}{" "}
                  of such US postings start at $150k or more, against {pct(pay.rows[1].at_least["150000"] / pay.rows[1].count)} for
                  software engineer titles.
                </li>
              </>
            )}
          </ol>
          <aside class="note">
            <p class="note-label">{zh ? "档案比岗位更新得慢" : "Profiles lag behind postings"}</p>
            <p>
            {zh
              ? "读这份报告之前要记住一点：岗位每天都在刷新，个人档案的技能栏却可能几个月才更新一次。越新的工具，档案越跟不上，所以越新的工具缺口看起来越大。这里的比值是需求和已公开技能之间的差距，不是劳动力缺口的直接测量。"
              : "One thing to hold while reading: postings refresh daily, while the skills on a profile may go months without an update. The newer the tool, the further profiles lag, so newer tools will look short of people partly for that reason. The ratios here compare demand with skills people have published, not with the skills people have."}
            </p>
          </aside>
          </div>
        </section>

        <Contents lang={lang} parts={parts} />

        <Chapter lang={lang} part={1} {...parts[0]} />

        <Figure
          id="both-sides"
          level={3}
          number="01"
          lang={lang}
          heading={
            zh
              ? `${names[biggest[0].id]} 和 ${names[biggest[1].id]} 两边都是最大的${opposite ? "，但方向相反" : ""}`
              : `${names[biggest[0].id]} and ${names[biggest[1].id]} are the largest on either side${opposite ? ", and they lean opposite ways" : ""}`
          }
          sub={
            zh
              ? "九个名称没有歧义的 AI 编程助手和 Agent 框架。左边是把它列为技能的档案，右边是提到它的在招岗位，同一刻度，按岗位数排序"
              : "Nine AI coding assistants and agent frameworks whose names are unambiguous. Profiles that list each one on the left, open postings that name it on the right, on one scale, sorted by postings"
          }
          alt={pairs.map((p) => `${names[p.id]}: ${p.s} ${zh ? "个档案" : "profiles"}, ${p.d} ${zh ? "个岗位" : "postings"}`).join("; ")}
          source={source}
          queries={toolQuery}
        >
          <div class="bf-head" aria-hidden="true">
            <span class="bf-h supply">{zh ? "列出技能的档案" : "Profiles listing it"}</span>
            <span />
            <span class="bf-h demand">{zh ? "提到它的岗位" : "Postings naming it"}</span>
          </div>
          <ol class="butterfly">
            {pairs.map((p) => (
              <li>
                <span class="bf-side supply">
                  <span class="bf-track" style={`--w: ${((p.s / sideMax) * 100).toFixed(2)}%`}>
                    <span class="bf-bar" />
                    <span class="bf-val">{number(lang, p.s)}</span>
                  </span>
                </span>
                <span class="bf-name">{names[p.id]}</span>
                <span class="bf-side demand">
                  <span class="bf-track" style={`--w: ${((p.d / sideMax) * 100).toFixed(2)}%`}>
                    <span class="bf-bar" />
                    <span class="bf-val">{number(lang, p.d)}</span>
                  </span>
                </span>
              </li>
            ))}
          </ol>
                <FigNotes
          slot="notes"
          lang={lang}
          shows={zh
            ? "LangChain 是唯一一个档案数远超岗位数的大工具，Claude Code 则是岗位数远超档案数。"
            : "LangChain is the one large tool with far more profiles than postings; Claude Code is the one with far more postings than profiles."}
          method={zh
            ? "岗位和档案的数量级相近，所以放在同一刻度上。"
            : "Postings and profiles run to similar sizes, so they share one scale."}
        />
        </Figure>

        <Figure
          id="gap"
          level={3}
          number="02"
          lang={lang}
          heading={
            zh
              ? `Claude Code 每个档案对应 ${number(lang, leader.r, 1)} 个岗位，${nearParity.join("、")} 接近一比一`
              : `Claude Code has ${number(lang, leader.r, 1)} postings per profile. ${nearParity.join(", ")} sit near one to one.`
          }
          sub={
            zh
              ? "每个列出该技能的档案对应多少个在招岗位，对数刻度，竖线是一比一"
              : "Open postings per profile that lists the skill, on a log scale; the vertical line is one to one"
          }
          alt={ratios.map((p) => `${names[p.id]} ${number(lang, p.r, 2)}`).join(", ")}
          source={source}
          queries={toolQuery}
        >
          <div class="dots">
            <div class="dots-axis" aria-hidden="true">
              <span />
              <span class="axis-track">
                {ticks.map((v) => (
                  <span class={v === LO ? "tick edge" : "tick"} style={`left: ${pos(v)}%`}>
                    {v < 1 ? number(lang, v, 2) : number(lang, v)}×
                  </span>
                ))}
              </span>
              <span />
            </div>
            {ratios.map((p) => (
              <div class={p.id === "claude-code" ? "dot-row focus" : "dot-row"}>
                <span class="dot-name">{names[p.id]}</span>
                <span class="dot-track" aria-hidden="true">
                  <span class="parity" style={`left: ${pos(1)}%`} />
                  <span class="dot" style={`left: ${pos(p.r)}%`} />
                </span>
                <span class="dot-val">{times(p.r)}</span>
              </div>
            ))}
          </div>
                <FigNotes
          slot="notes"
          lang={lang}
          shows={zh
            ? "LlamaIndex、AutoGen、CrewAI 也在 1.7 倍以上；DSPy 和 LangChain 在 0.5 倍左右，档案比岗位多一倍。"
            : "LlamaIndex, AutoGen, and CrewAI are also above 1.7; DSPy and LangChain sit near 0.5, with twice as many profiles as postings."}
          method={zh
            ? "比值大于 1 表示岗位多于列出技能的档案。刻度是对数的，所以 2 倍和 0.5 倍离 1 倍一样远。"
            : "Above 1, postings outnumber the profiles that list the skill. The scale is logarithmic, so 2 and 0.5 sit the same distance from one to one."}
        />
        </Figure>

        <Figure
          id="us-and-rest"
          level={3}
          number="03"
          lang={lang}
          heading={
            zh
              ? `美国以外的缺口更大：Claude Code 在美国是 ${number(lang, cc.us, 1)} 倍，在其他地方是 ${number(lang, cc.out, 1)} 倍`
              : `The gap is wider outside the US: ${number(lang, cc.us, 1)} postings per profile for Claude Code in the US, ${number(lang, cc.out, 1)} elsewhere`
          }
          sub={
            zh
              ? "每个档案对应的岗位数，美国（实心）和美国以外（空心）分开算，对数刻度"
              : "Postings per profile in the US (filled) and outside it (open), on a log scale"
          }
          alt={split
            .map((p) =>
              zh
                ? `${names[p.id]}：美国 ${number(lang, p.us, 2)}，美国以外 ${number(lang, p.out, 2)}`
                : `${names[p.id]}: US ${number(lang, p.us, 2)}, outside ${number(lang, p.out, 2)}`,
            )
            .join(zh ? "；" : "; ")}
          source={source}
          queries={toolQuery}
        >
          <div class="dots">
            <div class="dots-axis" aria-hidden="true">
              <span />
              <span class="axis-track">
                {ticks.map((v) => (
                  <span class={v === LO ? "tick edge" : "tick"} style={`left: ${pos(v)}%`}>
                    {v < 1 ? number(lang, v, 2) : number(lang, v)}×
                  </span>
                ))}
              </span>
              <span />
            </div>
            {split.map((p) => (
              <div class={p.id === "claude-code" ? "dot-row focus" : "dot-row"}>
                <span class="dot-name">{names[p.id]}</span>
                <span class="dot-track" aria-hidden="true">
                  <span class="parity" style={`left: ${pos(1)}%`} />
                  <span
                    class="link"
                    style={`left: ${Math.min(pos(p.us), pos(p.out))}%; width: ${Math.abs(pos(p.out) - pos(p.us))}%`}
                  />
                  <span class="dot us" style={`left: ${pos(p.us)}%`} />
                  <span class="dot out" style={`left: ${pos(p.out)}%`} />
                </span>
                <span class="dot-val">
                  {times(p.us)} / {times(p.out)}
                </span>
              </div>
            ))}
          </div>
          <p class="legend" slot="legend" aria-hidden="true">
            <span class="lg us">{zh ? "美国" : "US"}</span>
            <span class="lg out">{zh ? "美国以外" : "Outside the US"}</span>
          </p>
                <FigNotes
          slot="notes"
          lang={lang}
          shows={zh
