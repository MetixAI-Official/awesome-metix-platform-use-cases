---
/*
 * Design
 * Color follows data: a companies report, so the focus is the companies teal ink #07545E; the
 *   years before ChatGPT, and every comparison group, are the neutral grey #858395. Staff counts
 *   (profiles) keep the profiles violet #3D36C9 where they appear.
 * Hero: a pale mint field and ink type. The signature is the founding wave across the column:
 *   one column per founding year, the AI share of that year's new companies, with the launch of
 *   ChatGPT marked inside 2022, eleven twelfths of the way through the year.
 * Body: shares, never raw counts, wherever founding years are compared, because recent years are
 *   still filling in. The class is teal ink, the years before are grey, the partial year 2026 is
 *   a light teal and labelled "so far".
 * The roster: the small-team, big-round companies set as a yearbook page, the only place in the
 *   report where companies are named.
 * Wording: "companies that describe themselves as AI" (the definition reads tags and names, and
 *   about one in five it counts is not an AI company); counts are companies on the
 *   Metix AI Platform; staff counts are visible profiles, never a headcount.
 */
import BarList from "@site/components/charts/BarList.astro";
import FigNotes from "@site/components/charts/FigNotes.astro";
import Chapter from "@site/components/Chapter.astro";
import Contents from "@site/components/Contents.astro";
import Figure from "@site/components/charts/Figure.astro";
import { REPO, href, isoDate, longDate, number, titleHtml, type Lang } from "@site/i18n";
import controlsData from "../data/controls.json";
import countriesData from "../data/countries.json";
import growthData from "../data/growth.json";
import leanData from "../data/lean.json";
import metrosData from "../data/metros.json";
import receipt from "../data/receipt.json";
import sizeData from "../data/size.json";
import staffData from "../data/staff.json";
import themesData from "../data/themes.json";
import waveData from "../data/wave.json";
import cohortsQuery from "../queries/cohorts.json";
import definitionQuery from "../queries/definition.json";
import measuresQuery from "../queries/measures.json";
import placesQuery from "../queries/places.json";
import staffQuery from "../queries/staff.json";
import themesQuery from "../queries/themes.json";

interface Props {
  lang: Lang;
  section: "card" | "body" | "method";
  size?: "compact" | "full";
  entry: {
    slug: string;
    title: Record<Lang, string>;
    dek: Record<Lang, string>;
    snapshot?: Date;
    exploration_credits?: number;
  };
}

const { lang, section, entry } = Astro.props;
const zh = lang === "zh";
const snapshot = entry.snapshot ?? new Date(waveData.snapshot);
const iso = isoDate(snapshot);
const pct = (x: number, d = 1) => `${number(lang, x * 100, d)}%`;
const n = (x: number) => number(lang, x);
const times = (x: number) => (zh ? `${number(lang, x, 1)} 倍` : `${number(lang, x, 1)} times`);
const fail = (what: string): never => {
  throw new Error(`class-of-2023 report: ${what}`);
};
const COMPANIES = "POST /v1/companies/query";
const PEOPLE = "POST /v1/people/query";
const source = zh ? `来源：Metix AI Platform 公司数据，${iso}。` : `Source: Metix AI Platform, companies, ${iso}.`;
const sourceBoth = zh ? `来源：Metix AI Platform 公司与人才数据，${iso}。` : `Source: Metix AI Platform, companies and profiles, ${iso}.`;
const q = (file: string, spec: unknown, endpoint = COMPANIES) => ({ file, endpoint, spec });
const qDef = q("definition.json", definitionQuery);
const qCohorts = q("cohorts.json", cohortsQuery);
const qMeasures = q("measures.json", measuresQuery);
const qPlaces = q("places.json", placesQuery);
const qThemes = q("themes.json", themesQuery);
const qStaff = q("staff.json", staffQuery, PEOPLE);
const LAUNCH = "2022-11-30";
const LAUNCH_URL = "https://openai.com/index/chatgpt/";

// ---------- the founding wave (hero and figure 01)
type WaveRow = (typeof waveData.rows)[number];
const wave = waveData.rows as WaveRow[];
const yr = (y: number) => wave.find((r) => r.year === y) ?? fail(`no founding year ${y}`);
const span = (a: number, b: number) => wave.filter((r) => r.year >= a && r.year <= b);
const BEFORE = span(2019, 2022);
const CLASS = span(2023, 2025);
if (CLASS.length !== 3 || BEFORE.length !== 4) fail("a cohort is missing a year");
const sum = (rows: WaveRow[], k: keyof WaveRow) => rows.reduce((t, r) => t + (r[k] as number), 0);
// The denominator is every company of the same types the AI counts keep (nonprofits, educational
// institutions, and government agencies are left out of both).
const BASE = ("all_typed_count" in wave[0] ? "all_typed_count" : "all_count") as keyof WaveRow;
const shareIn = (rows: WaveRow[], k: keyof WaveRow, base: keyof WaveRow = BASE) => sum(rows, k) / sum(rows, base);
const classAi = sum(CLASS, "ai_count");
const classAll = sum(CLASS, BASE);
const beforeAi = sum(BEFORE, "ai_count");
const beforeAll = sum(BEFORE, BASE);
const classShare = classAi / classAll;
const beforeShare = beforeAi / beforeAll;
const jump = classShare / beforeShare;
if (jump < 2.5 || jump > 3.5) fail("the class is no longer about three times the share before; rewrite the title");
const y22 = yr(2022);
const y23 = yr(2023);
const share = (r: WaveRow) => r.ai_count / (r[BASE] as number);
const waveYears = wave.filter((r) => r.year >= 2010 && r.year <= 2026);
const waveMax = 0.018;
if (Math.max(...waveYears.map(share)) > waveMax) fail("a year's share runs past the wave's scale");
const waveTicks = [0, 0.005, 0.01, 0.015];

// The same jump under every definition the audit tested. The probe and the name path are biased in
// opposite directions (the audit's catch rates by era), so they bracket the definition.
// probe and loose keep every company type, so they are set against every company; the rest leave
// out nonprofits, educational institutions, and government agencies, as the base does.
type Def = { id: string; en: string; zh: string; noteEn: string; noteZh: string; focus?: boolean; everyType?: boolean };
const defs: Def[] = [
  { id: "probe", everyType: true, en: "Four broad tags", zh: "四个宽泛标签", noteEn: "understates: catches fewer new AI companies", noteZh: "偏低：新公司抓得少" },
  { id: "technical_neutral", en: "Three older technical tags", zh: "三个旧技术标签", noteEn: "deep learning, computer vision, NLP", noteZh: "深度学习、计算机视觉、自然语言处理" },
  { id: "technical", en: "Five technical tags", zh: "五个技术标签", noteEn: "the three, plus generative AI and LLMs", noteZh: "上面三个，加生成式 AI 和大语言模型" },
  { id: "loose", everyType: true, en: "Nine loose tags", zh: "九个宽松标签", noteEn: "43% precise", noteZh: "精度 43%" },
  { id: "ai", en: "This report's definition", zh: "本报告的定义", noteEn: "78% precise, same catch in every era", noteZh: "精度 78%，各时期覆盖率相同", focus: true },
  { id: "name_path", en: "AI in the company name", zh: "公司名里有 AI", noteEn: "overstates: new companies put AI in the name", noteZh: "偏高：新公司更爱把 AI 写进名字" },
];
const ratioOf = (key: string) => {
  const k = `${key}_count` as keyof WaveRow;
  if (!(k in wave[0])) return null;
  const base = (defs.find((d) => d.id === key)?.everyType ? "all_count" : BASE) as keyof WaveRow;
  return shareIn(CLASS, k, base) / shareIn(BEFORE, k, base);
};
const bracket = defs
  .map((d) => ({ ...d, ratio: ratioOf(d.id) }))
  .filter((d): d is Def & { ratio: number } => d.ratio !== null)
  .sort((a, b) => a.ratio - b.ratio);
const lowest = bracket[0];
const highest = bracket[bracket.length - 1];
if (lowest.ratio <= 1) fail("a definition shows no jump; rewrite figure 01");
const RATIO_MAX = Math.ceil(highest.ratio);

// ---------- where (figure 02): shares of the companies that give a country or a city
type CountryRow = (typeof countriesData.rows)[number];
const cRows = countriesData.rows as CountryRow[];
const cOf = (cohort: string, g: string) => cRows.find((r) => r.cohort === cohort && r.group === g);
const stated = (cohort: string) => (cOf(cohort, "total")?.count ?? fail("country total")) - (cOf(cohort, "no-country")?.count ?? 0);
const cShare = (cohort: string, g: string) => (cOf(cohort, g)?.count ?? 0) / stated(cohort);
const countryNames: Record<string, Record<Lang, string>> = {
  "United States": { en: "United States", zh: "美国" },
  India: { en: "India", zh: "印度" },
  "United Kingdom": { en: "United Kingdom", zh: "英国" },
  Canada: { en: "Canada", zh: "加拿大" },
  Germany: { en: "Germany", zh: "德国" },
  France: { en: "France", zh: "法国" },
  Australia: { en: "Australia", zh: "澳大利亚" },
  Netherlands: { en: "Netherlands", zh: "荷兰" },
  Spain: { en: "Spain", zh: "西班牙" },
  Pakistan: { en: "Pakistan", zh: "巴基斯坦" },
  Brazil: { en: "Brazil", zh: "巴西" },
  Italy: { en: "Italy", zh: "意大利" },
  Singapore: { en: "Singapore", zh: "新加坡" },
  Israel: { en: "Israel", zh: "以色列" },
  "United Arab Emirates": { en: "United Arab Emirates", zh: "阿联酋" },
  Switzerland: { en: "Switzerland", zh: "瑞士" },
};
const cName = (g: string) => countryNames[g]?.[lang] ?? fail(`no name for country ${g}`);
// Only countries in both cohorts' top 15: a country missing from one list is not 0, only below its 15th.
const ranked = (cohort: string) => new Set(cRows.filter((r) => r.cohort === cohort && typeof (r as { rank?: number }).rank === "number").map((r) => r.group));
const topCountries = [...ranked("class")].filter((g) => ranked("before").has(g))
  .map((g) => ({ g, before: cShare("before", g), klass: cShare("class", g) }))
  .sort((a, b) => b.klass - a.klass);
const us = topCountries.find((c) => c.g === "United States") ?? fail("no US row");
const noCountry = (cohort: string) => (cOf(cohort, "no-country")?.count ?? 0) / (cOf(cohort, "total")?.count ?? 1);
const china = countriesData.coverage as { year: number; all_count: number; ai_count: number }[];
const china23 = china.find((r) => r.year === 2023) ?? fail("no China 2023");

type MetroRow = { cohort: string; group: string; count: number; share?: number; city_count?: number; stated_share?: number };
const mRows = metrosData.rows as MetroRow[];
const mOf = (cohort: string, g: string) => mRows.find((r) => r.cohort === cohort && r.group === g);
const cityStated = (cohort: string) => mOf(cohort, "total")?.city_count ?? fail("metro city total");
const mShare = (cohort: string, g: string) => (mOf(cohort, g)?.count ?? 0) / cityStated(cohort);
const metroNames: Record<string, Record<Lang, string>> = {
  "sf-bay-area": { en: "San Francisco Bay Area", zh: "旧金山湾区" },
  "new-york-city": { en: "New York City", zh: "纽约市" },
  london: { en: "London", zh: "伦敦" },
  paris: { en: "Paris", zh: "巴黎" },
  berlin: { en: "Berlin", zh: "柏林" },
  toronto: { en: "Toronto", zh: "多伦多" },
  bengaluru: { en: "Bengaluru", zh: "班加罗尔" },
  "tel-aviv": { en: "Tel Aviv", zh: "特拉维夫" },
  singapore: { en: "Singapore", zh: "新加坡" },
  seattle: { en: "Seattle", zh: "西雅图" },
  boston: { en: "Boston and Cambridge", zh: "波士顿与剑桥" },
  austin: { en: "Austin", zh: "奥斯汀" },
  "los-angeles": { en: "Los Angeles", zh: "洛杉矶" },
  dubai: { en: "Dubai", zh: "迪拜" },
};
const metros = Object.keys(metroNames)
  .map((g) => ({ g, before: mShare("before", g), klass: mShare("class", g) }))
  .sort((a, b) => b.klass - a.klass);
const bay = metros.find((m) => m.g === "sf-bay-area") ?? fail("no Bay Area row");
const GEO_MAX = 0.4;
if (Math.max(...topCountries.map((c) => Math.max(c.before, c.klass))) > GEO_MAX) fail("a country runs past the geography scale");
const METRO_MAX = 0.12;
if (Math.max(...metros.map((m) => Math.max(m.before, m.klass))) > METRO_MAX) fail("a metro runs past the metro scale");

// ---------- what they say they build (figure 03)
type ThemeRow = { year: number; group: string; count: number; ai_count: number; share: number; loose_share?: number };
const tRows = themesData.rows as ThemeRow[];
const themeNames: Record<string, Record<Lang, string>> = {
  agents: { en: "AI agents", zh: "AI Agent" },
  "generative-ai": { en: "Generative AI", zh: "生成式 AI" },
  llm: { en: "Large language models", zh: "大语言模型" },
  "machine-learning": { en: "Machine learning", zh: "机器学习" },
  "computer-vision": { en: "Computer vision", zh: "计算机视觉" },
  robotics: { en: "Robotics", zh: "机器人" },
  health: { en: "Health", zh: "医疗健康" },
  "data-analytics": { en: "Data and analytics", zh: "数据与分析" },
};
const THEME_YEARS = [2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026];
const themeSeries = Object.keys(themeNames).map((g) => {
  const pts = THEME_YEARS.map((y) => tRows.find((r) => r.group === g && r.year === y) ?? fail(`no theme ${g} ${y}`));
  return { g, pts };
});
const themeAt = (g: string, y: number, k: "share" | "loose_share" = "share") => {
  const r = tRows.find((x) => x.group === g && x.year === y) ?? fail(`no theme ${g} ${y}`);
  return (r[k] as number | undefined) ?? fail(`no ${k} for ${g} ${y}`);
};
const THEME_MAX = 0.6;
if (Math.max(...tRows.filter((r) => themeNames[r.group]).map((r) => r.share)) > THEME_MAX) fail("a theme runs past its scale");

// ---------- the roster (figure 06)
type LeanRow = (typeof leanData.rows)[number];
const bandOrder = ["1b-plus", "250m-1b", "100m-250m", "50m-100m"];
// The roster is the class only; the companies founded in 2022, just before the launch, are named in
// the notes.
const leanAll = [...(leanData.rows as LeanRow[])];
const pre2023 = leanAll.filter((r) => r.founded_year < 2023).sort((a, b) => a.company.localeCompare(b.company));
const roster = leanAll.filter((r) => r.founded_year >= 2023).sort(
  (a, b) => bandOrder.indexOf(a.amount_band) - bandOrder.indexOf(b.amount_band) || b.month.localeCompare(a.month) || a.company.localeCompare(b.company),
);
if (roster.some((r) => !bandOrder.includes(r.amount_band))) fail("a roster band is not in the order");
const bandName: Record<string, Record<Lang, string>> = {
  "1b-plus": { en: "$1 billion or more", zh: "10 亿美元以上" },
  "250m-1b": { en: "$250 million to $1 billion", zh: "2.5 亿到 10 亿美元" },
  "100m-250m": { en: "$100 to $250 million", zh: "1 亿到 2.5 亿美元" },
  "50m-100m": { en: "$50 to $100 million", zh: "5,000 万到 1 亿美元" },
};
const rosterBands = bandOrder
  .map((b) => ({ b, rows: roster.filter((r) => r.amount_band === b) }))
  .filter((x) => x.rows.length > 0);
const leanCount = (g: string) =>
  ((leanData.counts as { group: string; count: number }[]).find((c) => c.group === g) ?? fail(`no lean count ${g}`)).count;
const staffBand = (b: string) => (zh ? `${b.replace("-", " 到 ")} 人` : `${b.replace("-", " to ")} staff`);
const monthLabel = (m: string) => {
  const [y, mo] = m.split("-").map(Number);
  return zh ? `${y} 年 ${mo} 月` : new Date(Date.UTC(y, mo - 1, 1)).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
};

// ---------- growth and money against every company of the same age (figures 04 and 05)
type Ctl = { measure: string; cohort?: string; year?: number; group: string; ai_count: number; non_ai_count: number; ai_share: number; non_ai_share: number };
const ctl = controlsData.rows as Ctl[];
const ctlOf = (measure: string, cohort: string, g: string) =>
  ctl.find((r) => r.measure === measure && r.cohort === cohort && r.group === g) ?? fail(`no control ${measure} ${cohort} ${g}`);
// Growth shares are of the companies that state a figure, so not-stated is taken out of the base.
const grown = (cohort: string, side: "ai" | "non_ai", g: string) => {
  const total = ctlOf("growth", cohort, "total");
  const ns = ctlOf("growth", cohort, "not-stated");
  const base = side === "ai" ? total.ai_count - ns.ai_count : total.non_ai_count - ns.non_ai_count;
  const r = ctlOf("growth", cohort, g);
  return (side === "ai" ? r.ai_count : r.non_ai_count) / base;
};
const shrank = (cohort: string, side: "ai" | "non_ai") => grown(cohort, side, "below-minus-20") + grown(cohort, side, "minus-20-to-0");
const doubled = (cohort: string, side: "ai" | "non_ai") => grown(cohort, side, "100-plus");
const growthBase = (cohort: string, side: "ai" | "non_ai") => {
  const total = ctlOf("growth", cohort, "total");
  const ns = ctlOf("growth", cohort, "not-stated");
  return side === "ai" ? total.ai_count - ns.ai_count : total.non_ai_count - ns.non_ai_count;
};
if (Math.abs(doubled("class", "ai") - (growthData.rows.find((r) => r.cohort === "class" && r.group === "100-plus")?.share_of_stated ?? 0)) > 0.001) {
  fail("growth.json and controls.json disagree on the class's doubled share");
}
const gap = doubled("class", "ai") - doubled("class", "non_ai");
const dated = (cohort: string, side: "ai" | "non_ai") => ctlOf("funding", cohort, "dated")[`${side}_share`];
const datedTimes = dated("class", "ai") / dated("class", "non_ai");
const AMOUNT_BANDS = ["under-1m", "1m-5m", "5m-20m", "20m-50m", "50m-100m", "100m-1b", "1b-plus"];
const amountName: Record<string, Record<Lang, string>> = {
  "under-1m": { en: "Under $1 million", zh: "100 万美元以下" },
  "1m-5m": { en: "$1 to $5 million", zh: "100 万到 500 万" },
  "5m-20m": { en: "$5 to $20 million", zh: "500 万到 2,000 万" },
  "20m-50m": { en: "$20 to $50 million", zh: "2,000 万到 5,000 万" },
  "50m-100m": { en: "$50 to $100 million", zh: "5,000 万到 1 亿" },
  "100m-1b": { en: "$100 million to $1 billion", zh: "1 亿到 10 亿" },
  "1b-plus": { en: "$1 billion or more", zh: "10 亿美元以上" },
};
const amounts = AMOUNT_BANDS.map((g) => ({ g, ai: ctlOf("us-amount", "class", g).ai_share, non: ctlOf("us-amount", "class", g).non_ai_share }));
const amountN = ctlOf("us-amount", "class", "total");
const AMOUNT_MAX = 0.5;
if (Math.max(...amounts.map((a) => Math.max(a.ai, a.non))) > AMOUNT_MAX) fail("an amount band runs past its scale");
const sizeOf = (year: number, g: string) =>
  ctl.find((r) => r.measure === "size" && r.year === year && r.group === g) ?? fail(`no size ${year} ${g}`);
const solo25 = sizeOf(2025, "Myself Only");

// ---------- staff (figure 07): visible profiles at the largest companies of each cohort
// Two sets: every kept company, and the same without the data-labeling marketplaces, whose visible
// staff are mostly contractors. The chart shows the full set; the notes give the other.
type StaffRow = { cohort: string; set: string; group: string; kind: string; count: number | string | null; share: number | null };
const sRows = staffData.rows as StaffRow[];
const sIn = (set: string) => (cohort: string, g: string) =>
  sRows.find((r) => r.set === set && r.cohort === cohort && r.group === g) ?? fail(`no staff row ${set} ${cohort} ${g}`);
const sOf = sIn("all");
const sNoLab = sIn("without-labeling");
const bigNoLab = (cohort: string) => sNoLab(cohort, "big-tech").share ?? fail(`big tech without labeling is withheld for ${cohort}`);
const staffTotal = (cohort: string) => sOf(cohort, "total").count as number;
const employerNames: Record<string, Record<Lang, string>> = {
  "big-tech": { en: "Any of the big tech companies below", zh: "下面任一大型科技公司" },
  google: { en: "Google, Google DeepMind included", zh: "Google（含 Google DeepMind）" },
  amazon: { en: "Amazon", zh: "Amazon" },
  microsoft: { en: "Microsoft", zh: "Microsoft" },
  meta: { en: "Meta", zh: "Meta" },
  apple: { en: "Apple", zh: "Apple" },
  nvidia: { en: "NVIDIA", zh: "NVIDIA" },
  "founder-title": { en: "Current title names founder", zh: "当前职位写着创始人" },
};
// The rollup first, the employers by the class's share, and the founder titles apart at the end.
const staffRows = Object.keys(employerNames)
  .map((g) => ({ g, klass: sOf("class", g), base: sOf("baseline", g) }))
  .sort((a, b) => {
    const rank = (g: string) => (g === "big-tech" ? 0 : g === "founder-title" ? 2 : 1);
    return rank(a.g) - rank(b.g) || (b.klass.share ?? 0) - (a.klass.share ?? 0);
  });
const STAFF_MAX = 0.08;
if (Math.max(...staffRows.flatMap((r) => [r.klass.share ?? 0, r.base.share ?? 0])) > STAFF_MAX) fail("a staff row runs past its scale");

const uaeRank = (cohort: string) => (cOf(cohort, "United Arab Emirates") as { rank?: number } | undefined)?.rank ?? fail(`no UAE rank for ${cohort}`);
const ordinal = (i: number) => {
  const s = ["th", "st", "nd", "rd"];
  const v = i % 100;
  return `${i}${s[(v - 20) % 10] || s[v] || s[0]}`;
};
const parts = [
  {
    id: "part-rise",
    figures: ["01", "02"],
    title: zh ? "增幅与新词" : "The rise, in new words",
    note: zh
      ? "换不同的定义看增幅有多大，以及这一届用什么词描述自己。"
      : "How large the rise is under each definition the audit tested, and the words the class uses to describe itself.",
  },
  {
    id: "part-where",
    figures: ["03"],
    title: zh ? "总部在哪里" : "Where they are",
    note: zh ? "这一届和之前的 AI 公司，总部所在的国家和城市圈。" : "The headquarters countries and metros of the class, against the AI companies founded before it.",
  },
  {
    id: "part-money",
    figures: ["04", "05", "06"],
    title: zh ? "规模与融资" : "Size and money",
    note: zh
      ? "和同一批成立年份的其他公司比员工增长和融资，以及员工很少、融资很大的那些公司。"
      : "Staff growth and funding against other companies founded in the same years, and the small teams with large rounds.",
  },
  {
    id: "part-people",
    figures: ["07"],
    title: zh ? "员工从哪里来" : "Where their staff came from",
    note: zh ? "这一届最大的那些公司，可见员工以前在哪里工作。" : "Where the visible staff of the class's largest companies worked before.",
  },
];

// "The Bay Area rises under every definition": checked here, or the build stops.
type Cmp = Record<string, number | string>;
for (const d of ["definition", "probe", "loose"]) {
  const row = (c: string) => (metrosData.comparison as Cmp[]).find((r) => r.definition === d && r.cohort === c) ?? fail(`no comparison ${d} ${c}`);
  if ((row("class")["sf-bay-area_share_of_city"] as number) <= (row("before")["sf-bay-area_share_of_city"] as number)) fail(`the Bay Area does not rise under ${d}`);
}
